  "characters": [
    {
      "age": "20",
      "name": "秦昊",
      "gender": "男",
      "skills": "觉醒前：普通大学生，体能一般，逻辑思维能力强。觉醒后：1. 异能‘帝王威压’：可释放精神压迫，对低阶丧尸有震慑效果。2. 丧尸感知：能模糊感知一定范围内丧尸的动向和情绪。3. 体质强化：身体素质远超常人，恢复力强。4. 血脉共鸣：与秦朝遗物或阵法接触时，能触发记忆碎片或共鸣。",
      "role_type": "主角",
      "appearance": "身高一米七八，体型偏瘦但线条匀称，典型的在校大学生模样。面容清秀，眉宇间带着一股与年龄不符的沉稳，眼神深邃，偶尔会闪过一丝不易察觉的锐利。感染觉醒后，瞳孔在情绪激动时会泛起极淡的金色流光。",
      "background": "普通家庭出身的在校大学生，父母常年在外工作，由祖父母带大。从小与林雪是邻居，青梅竹马。家族中流传着一些关于祖先的模糊传说，但从未当真。直到末日爆发，被丧尸咬伤后，体内沉睡的秦始皇血脉才被激活。",
      "personality": "性格内敛，思维缜密，遇事冷静，有很强的责任感。平时话不多，但关键时刻总能做出最理性的判断。内心深处有保护他人的强烈意愿，这源于童年时未能保护好林雪的愧疚。觉醒后，性格中多了一份果决与霸气，但依旧克制。",
      "current_goal": "保护林雪和身边的同伴，在末日中生存下去，并探寻自身血脉与丧尸病毒爆发的真相。",
      "first_chapter": 1,
      "current_status": "存活，处于异能觉醒与探索阶段。"
    },
    {
      "age": "22",
      "name": "林雪",
      "gender": "女",
      "skills": "1. 精湛的格斗与体术：体育学院背景，近身战斗力强。2. 优秀的体能与耐力：长期锻炼，身体素质极佳。3. 冷静的判断力：在危机中能迅速分析局势，做出最优选择。4. 基础急救知识：为照顾秦昊自学过。",
      "role_type": "主角",
      "appearance": "身高一米六八，身材高挑，长发常束成利落的马尾。五官精致，气质清冷，一双凤眼总是带着审视和疏离。穿着简约干练，行动时动作敏捷，一看便知是常年锻炼的结果。",
      "background": "与秦昊青梅竹马，比他大两岁，就读于同城另一所大学的体育学院，主修运动康复。父母是普通工薪阶层。从小就像姐姐一样照顾秦昊，两人关系亲密但并非情侣。末日爆发时，第一时间想到的就是赶到秦昊身边。",
      "personality": "典型的外冷内热。对外人冷淡疏离，戒备心强，但对自己认定的人（如秦昊）会爆发出惊人的保护欲和温柔。做事果断，执行力极强，有很强的生存本能和危机意识。内心深处极其重视感情，但不善于表达。",
      "current_goal": "确保秦昊的安全与稳定，带领小队在末日中生存，并支持秦昊探寻真相。",
      "first_chapter": 1,
      "current_status": "存活，作为小队核心战力与决策者之一。"
    },
    {
      "age": "28",
      "name": "赵铁",
      "gender": "男",
      "skills": "1. 顶级军事素养：精通各种枪械、冷兵器、战术指挥。2. 强大的近身格斗能力：军体拳、擒拿术炉火纯青。3. 野外生存专家：精通各种恶劣环境下的生存技巧。4. 危机处理与领导力：能快速制定作战计划，稳定团队情绪。",
      "role_type": "配角",
      "appearance": "身高一米八五，身材魁梧壮硕，肌肉贲张，充满力量感。面容刚毅，下巴留着短硬的胡茬，眼神锐利如鹰，带着军人特有的审视感。身上有多处旧伤疤，更添几分悍勇之气。",
      "background": "前特种部队成员，因伤退役，目前在一家安保公司担任教官。末日爆发时正在执行任务，凭借过硬的军事素养幸存下来。遇到秦昊小队后，被秦昊的特殊能力和领导潜质吸引，决定留下协助。",
      "personality": "沉稳坚毅，纪律性极强，说一不二。拥有丰富的实战经验和危机处理能力。对战友极为看重，有强烈的保护欲。外表粗犷，内心实则细腻，善于观察。对秦昊的特殊能力既警惕又好奇，但最终选择信任。",
      "current_goal": "保护幸存者，建立安全的生存据点，并协助秦昊成长，应对更大的危机。",
      "first_chapter": 11,
      "current_status": "存活，小队的战斗核心与战术指挥。"
    },
    {
      "age": "19",
      "name": "陈雨桐",
      "gender": "女",
      "skills": "1. 扎实的医学知识：精通急救、病理分析、药物配置。2. 细致的观察与记录能力：对秦昊的身体变化进行详细记录和分析。3. 基础化学与生物学知识：可用于制作简易药品或分析丧尸病毒特性。4. 冷静的头脑：在医疗急救中能保持镇定。",
      "role_type": "配角",
      "appearance": "身高一米六二，体型娇小，面容清秀，戴着一副细框眼镜，眼神中总是闪烁着求知与好奇的光芒。穿着干净整洁，即使在末日也尽力保持仪容。随身总是带着一个装满医疗用品的背包。",
      "background": "医学院大二学生，主修临床医学。末日爆发时正在实验室，凭借对病毒的初步了解和冷静头脑幸存。遇到秦昊小队后，被秦昊的特殊感染与觉醒过程深深吸引，决定留下进行观察和研究，同时提供医疗支持。",
      "personality": "温和善良，富有同情心，对生命充满敬畏。性格有些内向，但在专业领域（医学）极其自信和专注。对未知事物有强烈的好奇心和探索欲，尤其是秦昊的特殊体质。逻辑思维缜密，善于分析和记录。",
      "current_goal": "在末日中尽可能救治伤员，并深入研究秦昊的特殊体质与丧尸病毒，寻找对抗或治愈的方法。",
      "first_chapter": 11,
      "current_status": "存活，小队的医疗官与秦昊体质的研究者。"
    },
    {
      "age": "21",
      "name": "王胖子",
      "gender": "男",
      "skills": "擅长搜集物资与后勤保障，对城市地形了如指掌。拥有出色的社交能力，能快速与陌生人建立信任。在压力下能保持冷静，常能想出出人意料的解决方案。",
      "role_type": "配角",
      "appearance": "身材圆润，总是带着憨厚的笑容。喜欢穿着宽松的运动服，脖子上挂着一条夸张的金链子（实为假货）。圆脸小眼，看起来人畜无害，但眼神中透着机灵。",
      "background": "男主的大学室友兼挚友，家境普通但性格豁达。在丧尸病毒爆发时正在宿舍打游戏，靠着机智和一点运气逃过一劫。末日危机中展现出惊人的生存适应能力与人际协调能力。",
      "personality": "乐观开朗，是团队中的开心果。看似大大咧咧，实则心思细腻，善于观察他人情绪。对朋友极其忠诚，愿意为保护队友付出一切。有时会因过于乐观而低估危险。",
      "current_goal": "保护好男主和其他队友，在末日中尽可能多地拯救幸存者，找到安全的永久避难所。",
      "first_chapter": 11,
      "current_status": "存活"
    },
    {
      "age": "未知",
      "name": "秦影",
      "gender": "男",
      "skills": "拥有准帝境的部分知识与见识，能解读秦朝秘法与阵法。可通过血脉共鸣向男主传递记忆碎片与警示。在皇陵范围内拥有有限的实体化能力，可短暂干预现实。",
      "role_type": "配角",
      "appearance": "身形虚幻，穿着秦代帝王冕服，面容模糊但威严无比。周身环绕着淡金色的光晕，眼中闪烁着跨越千年的智慧与沧桑。在显现实体时，会呈现出半透明的金色灵体状态。",
      "background": "秦始皇在突破帝境失败前，将自己的一缕神魂与部分记忆封印在皇陵核心阵法中。本是为了守护皇陵秘密，但在末日危机中被男主的血脉激活。知晓秦始皇突破失败的真相与丧尸病毒的起源。",
      "personality": "威严而古老，承载着秦始皇的部分意志与记忆。对后世子孙（男主）既严厉又关怀，言语间常带有秦代文言的韵味。坚守着守护华夏的使命，但受限于灵识状态，无法直接干预现实。",
      "current_goal": "引导男主觉醒血脉力量，完成秦始皇未竟的使命——抵御即将入侵的境外强敌，守护华夏文明。",
      "first_chapter": 21,
      "current_status": "存活（灵识状态）"
    },
    {
      "age": "35",
      "name": "周明远",
      "gender": "男",
      "skills": "精通多国语言与格斗术，擅长情报分析与战术指挥。拥有先进的科技装备，包括能探测特殊能量波动的仪器。对秦朝历史与修仙体系有深入研究，能解读部分古文字。",
      "role_type": "反派",
      "appearance": "身材高瘦，面容冷峻，有着北欧人种的深邃轮廓，但眼神中透着东方人特有的锐利。总是穿着剪裁得体的黑色战术服，左眼下方有一道细长的疤痕，头发整齐地向后梳起，给人一种严谨而危险的感觉。",
      "background": "前某国特种部队指挥官，在一次秘密任务中接触到关于秦始皇长生不老传说的机密档案。后被境外神秘组织招募，专门负责收集全球范围内的超自然遗物。在丧尸病毒爆发前就已潜入中国境内，寻找秦始皇陵的线索。",
      "personality": "极度理性且冷酷无情，将任务视为最高优先级。表面彬彬有礼，实则心机深沉，善于利用他人弱点。对力量有着近乎偏执的追求，认为秦始皇的遗产是改变世界格局的关键。",
      "current_goal": "找到秦始皇陵的核心区域，获取突破帝境的秘密与丧尸病毒的原始样本，为组织带回足以改变世界格局的力量。",
      "first_chapter": 51,
      "current_status": "存活"
    }
  ],
  "foreshadowing": [
