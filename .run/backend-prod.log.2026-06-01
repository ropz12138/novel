类型：科幻末日
卷：第一卷：末日降临
时间线节点数：18
伏笔数：10

完整大纲：
{
  "story": {
    "genre": "科幻末日",
    "title": "末日：我的秦始皇血脉觉醒了",
    "volume": "第一卷：末日降临"
  },
  "branches": [
    {
      "id": "B1",
      "name": "林雪的守护线",
      "side": "left",
      "summary": "林雪在秦昊感染期间独自外出搜寻物资和药品，遭遇其他幸存者团队的排挤与威胁。她凭借格斗技能化解危机，同时发现城市中出现了有组织的幸存者团体，为后续势力冲突埋下伏笔。林雪的外冷内热性格在保护秦昊的过程中得到充分展现。",
      "attach_to": "T2",
      "chapter_end": 15,
      "chapter_start": 6
    },
    {
      "id": "B2",
      "name": "陈雨桐的病毒研究线",
      "side": "right",
      "summary": "陈雨桐加入小队后，开始系统研究秦昊的血液样本和丧尸病毒。她发现秦昊的血液中存在一种未知的金色微粒，与普通丧尸病毒有本质区别。这条线索逐渐指向秦始皇血脉的秘密，但此时她只以为是某种罕见的基因变异。",
      "attach_to": "T3",
      "chapter_end": 25,
      "chapter_start": 11
    },
    {
      "id": "B3",
      "name": "赵铁的旧部联络线",
      "side": "left",
      "summary": "赵铁在尸潮危机后，通过军用通讯频道联系到部分幸存的战友。他们组建了一支小型军事化幸存者团体，与秦昊小队形成互助关系。这条线为后续组建人类联盟提供了军事力量基础，同时也带来了关于政府残余力量的信息。",
      "attach_to": "T4",
      "chapter_end": 30,
      "chapter_start": 16
    },
    {
      "id": "B4",
      "name": "王胖子的物资网络线",
      "side": "right",
      "summary": "王胖子利用其社交能力，在城市各处幸存者据点之间建立起物资交换网络。他无意中发现某些据点在秘密收集秦朝文物，引起秦昊的警觉。这条线揭示了末日中各方势力对秦始皇遗产的觊觎，为后续境外势力登场做铺垫。",
      "attach_to": "T5",
      "chapter_end": 35,
      "chapter_start": 21
    }
  ],
  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "丧尸病毒突然爆发，男主在校园中遭遇危机，被丧尸咬伤感染。青梅竹马女主赶到，决定陪伴他度过感染期。",
      "time_node": "末日第1-7天",
      "chapter_end": 5,
      "chapter_start": 1,
      "development_node": "末日爆发与初始求生"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "男主在女主照料下经历高烧与幻觉，期间出现神秘血脉共鸣。最终觉醒异能，同时获得部分丧尸能力，成为特殊存在。",
      "time_node": "末日第8-15天",
      "chapter_end": 10,
      "chapter_start": 6,
      "development_node": "感染危机与初次觉醒"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "男女主结识其他幸存者，组建求生小队。建立临时据点，男主开始探索自身能力，发现能感知丧尸动向。",
      "time_node": "末日第16-30天",
      "chapter_end": 15,
      "chapter_start": 11,
      "development_node": "组建小队与建立据点"
    },
    {
      "id": "T4",
      "order": 4,
      "summary": "大规模尸潮来袭，据点岌岌可危。男主在战斗中首次展现控制丧尸的能力，引起队友震惊与疑虑。",
      "time_node": "末日第31-45天",
      "chapter_end": 20,
      "chapter_start": 16,
      "development_node": "首次大规模尸潮与据点危机"
    },
    {
      "id": "T5",
      "order": 5,
      "summary": "男主在探索中发现秦朝文物，触发血脉记忆碎片。开始怀疑自身能力来源，伏笔逐渐显现。",
      "time_node": "末日第46-60天",
      "chapter_end": 25,
      "chapter_start": 21,
      "development_node": "血脉觉醒与秦朝遗物"
    },
    {
      "id": "T6",
      "order": 6,
      "summary": "遭遇强大变异丧尸，男主濒死之际血脉力量爆发。战后获得关键线索，暗示丧尸病毒与秦始皇有关。",
      "time_node": "末日第61-75天",
      "chapter_end": 30,
      "chapter_start": 26,
      "development_node": "第一卷高潮与真相初现"
    },
    {
      "id": "T7",
      "order": 7,
      "summary": "为探寻真相，队伍前往秦始皇陵所在地。途中遭遇其他势力，男主血脉能力持续进化。",
      "time_node": "末日第76-90天",
      "chapter_end": 35,
      "chapter_start": 31,
      "development_node": "前往古都与线索追寻"
    },
    {
      "id": "T8",
      "order": 8,
      "summary": "与其他幸存者势力发生冲突，女主陷入危险。男主为救她彻底激发血脉力量，展现准帝境威压。",
      "time_node": "末日第91-105天",
      "chapter_end": 40,
      "chapter_start": 36,
      "development_node": "势力冲突与女主危机"
    },
    {
      "id": "T9",
      "order": 9,
      "summary": "进入秦始皇陵，触发远古阵法。男主获得完整血脉记忆，知晓秦始皇突破失败与丧尸病毒起源。",
      "time_node": "末日第106-120天",
      "chapter_end": 45,
      "chapter_start": 41,
      "development_node": "秦始皇陵探索与记忆觉醒"
    },
    {
      "id": "T10",
      "order": 10,
      "summary": "通过陵墓中的信息，完全揭露秦始皇为抵御外敌突破失败、丧尸病毒是失败产物的真相。男主秦始皇血脉身份确认。",
      "time_node": "末日第121-135天",
      "chapter_end": 50,
      "chapter_start": 46,
      "development_node": "中期真相大揭露"
    },
    {
      "id": "T11",
      "order": 11,
      "summary": "发现境外势力已渗透，他们也在寻找秦始皇遗产。丧尸病毒爆发背后有更大阴谋。",
      "time_node": "末日第136-150天",
      "chapter_end": 55,
      "chapter_start": 51,
      "development_node": "境外威胁显现"
    },
    {
      "id": "T12",
      "order": 12,
      "summary": "男主联合各方势力，组建人类联盟。开始系统训练，准备应对境外威胁与丧尸危机。",
      "time_node": "末日第151-165天",
      "chapter_end": 60,
      "chapter_start": 56,
      "development_node": "组建联盟与备战"
    },
    {
      "id": "T13",
      "order": 13,
      "summary": "境外势力大规模入侵，同时引发超级尸潮。男主率联盟迎战，展现秦始皇血脉的真正力量。",
      "time_node": "末日第166-180天",
      "chapter_end": 65,
      "chapter_start": 61,
      "development_node": "第二卷高潮与境外入侵"
    },
    {
      "id": "T14",
      "order": 14,
      "summary": "决战前夜，男主与女主关系升华。揭示秦始皇延缓外敌的手段，男主继承其意志。",
      "time_node": "末日第181-195天",
      "chapter_end": 70,
