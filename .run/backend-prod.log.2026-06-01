    },
    {
      "id": "T15",
      "order": 15,
      "summary": "对抗境外势力与丧尸之王。男主融合丧尸能力与血脉力量，达到新境界。",
      "time_node": "末日第196-210天",
      "chapter_end": 75,
      "chapter_start": 71,
      "development_node": "最终决战与丧尸之王"
