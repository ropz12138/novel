      "character_name": "苏念雪"
    },
    {
      "summary": "险些被安全区军方发现异能秘密。",
      "link_type": "conflict",
      "timeline_id": "T8",
      "character_name": "秦曜"
    },
    {
      "summary": "从普通大学生成长为团队核心领袖。",
      "link_type": "lead",
      "timeline_id": "T14",
      "character_name": "秦曜"
    },
    {
      "summary": "守护高烧昏迷的秦曜，寸步不离。",
      "link_type": "appear",
      "timeline_id": "T4",
      "character_name": "苏念雪"
    },
    {
      "summary": "在尸王之战中辅助秦曜作战。",
      "link_type": "appear",
      "timeline_id": "T6",
      "character_name": "苏念雪"
    }
  ],
  "character_briefs": [
    {
      "age": "21",
      "name": "秦曜",
      "brief": "江城大学历史系大三学生，秦始皇血脉继承者，被丧尸咬伤后觉醒异能【尸皇诀】，拥有操控丧尸与吸收晶核的独特能力，从普通大学生成长为末日关键人物",
      "gender": "男",
      "role_type": "主角",
      "first_chapter": 1
    },
    {
      "age": "23",
      "name": "苏念雪",
      "brief": "秦曜的青梅竹马，江城医科大学研一学生，年上两岁，外冷内热，表面冷淡实则对秦曜极为在意，末日中逐渐觉醒治愈系异能，与秦曜慢热发展感情线",
      "gender": "女",
      "role_type": "主角",
      "first_chapter": 6
    },
    {
      "age": "21",
      "name": "刘洋",
      "brief": "秦曜室友兼死党，外号胖子，计算机系学生，性格乐天搞笑，末日中觉醒感知型异能【数据视野】，是小队的战术情报核心与气氛调节剂",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 3
    },
    {
      "age": "22",
      "name": "陈锋",
      "brief": "江城大学体育学院田径队队长，退伍军人家庭出身，性格刚毅果敢，末日中觉醒力量型异能【钢铁之躯】，担任小队主攻手与近战核心",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 5
    },
    {
      "age": "20",
      "name": "林婉",
      "brief": "江城大学生物工程系学霸，戴眼镜的文静女生，拥有超强分析能力，末日中觉醒植物操控异能，后期成为研究丧尸病毒与秦始皇血脉关联的关键人物",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 7
    },
    {
      "age": "28",
      "name": "韩若冰",
      "brief": "军方安全区少校军官，冷艳干练的女军人，暗中掩护秦曜的神秘军官，真实身份是守护秦始皇血脉秘密的守陵人后裔，后期成为秦曜了解真相的重要引路人",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 46
    },
    {
      "age": "35",
      "name": "赵牧",
      "brief": "安全区军方上校指挥官，铁血务实的末世军人领袖，初期对秦曜持怀疑态度，经历丧尸围城后成为秦曜的重要盟友，代表人类军方势力",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 48
    },
    {
      "age": "外貌30岁/实际2000+",
      "name": "墨渊",
      "brief": "秦始皇时期存活至今的修仙者，曾是始皇麾下方士，末法时代修为跌至金丹境，在秦曜梦境中以玄黑龙袍残影出现，是揭示秦始皇布局真相的关键引路人",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 55
    },
    {
      "age": "外貌25岁/实际未知",
      "name": "白无尘",
      "brief": "域外天魔在人间的投影化身，以俊美青年形象潜入人类幸存者中，操控丧尸潮与变异兽潮，是境外入侵势力的先遣棋子，中期主要反派",
      "gender": "男",
      "role_type": "反派",
      "first_chapter": 85
    },
    {
      "age": "17",
      "name": "秦岚",
      "brief": "秦曜的亲妹妹，高中生，末日爆发时与父母失散，被神秘势力带走，体内同样流淌秦始皇血脉，后期成为域外天魔试图夺取血脉的关键目标",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 95
    },
    {
      "age": "40",
      "name": "姜破军",
      "brief": "前特种部队教官，末日中觉醒战斗直觉异能，成为北方最大幸存者基地的武装力量首领，性格豪迈重义，后期率部加入对抗域外天魔的最终战役",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 110
    },
    {
      "age": "未知",
      "name": "血瞳",
      "brief": "域外天魔座下三巨头之一，本体为星际流浪种族，以血红色瞳孔为标志，拥有操控生物基因变异的能力，是丧尸病毒的幕后推手之一，中期大反派",
      "gender": "男",
      "role_type": "反派",
      "first_chapter": 150
    },
    {
      "age": "外貌20岁/实际500+",
      "name": "云清瑶",
      "brief": "隐世修仙宗门传人，金丹境女修，因丧尸病毒引发的天地异变而出山，初期与秦曜敌对后化敌为友，代表修仙势力与人类合作对抗域外天魔",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 200
    },
    {
      "age": "外貌40岁/实际2200+",
      "name": "嬴照",
      "brief": "秦始皇的残魂分身，沉睡于骊山地下秘境，在秦曜血脉完全觉醒后被唤醒，以残魂形态指引秦曜完成始皇未竟的布局，是连接过去与现在的关键纽带",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 280
    },
    {
      "age": "未知/万年以上",
      "name": "噬空",
      "brief": "域外天魔之主，以吞噬星球为生的宇宙级存在，秦始皇两千年前预感到的终极威胁，丧尸病毒是始皇为对抗它而设计的另类造兵计划，最终BOSS",
      "gender": "男",
      "role_type": "反派",
      "first_chapter": 350
    },
    {
      "age": "25",
      "name": "沈清秋",
      "brief": "北方幸存者基地的医学研究主任，病毒学与基因工程专家，在研究丧尸病毒过程中发现秦始皇血脉的秘密，成为秦曜团队的科学顾问",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 130
    },
    {
      "age": "30",
      "name": "铁牛",
      "brief": "校园幸存者中的普通保安，退伍老兵，为人忠厚可靠，末日初期为保护学生牺牲，是触发秦曜责任感的催泪角色",
      "gender": "男",
      "role_type": "龙套",
      "first_chapter": 24
    },
    {
      "age": "45",
      "name": "周文渊",
      "brief": "安全区文职官员，野心勃勃的政客型人物，试图利用丧尸病毒谋取权力，暗中与域外天魔棋子勾结，中期出卖人类利益的内奸",
      "gender": "男",
      "role_type": "反派",
      "first_chapter": 60
    }
  ]
}
