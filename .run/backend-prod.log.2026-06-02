  "characters": [
    {
      "age": "21",
      "name": "林轩",
      "gender": "男",
      "skills": "【丧尸感知】能感知方圆百米内丧尸的位置和数量，范围随等级提升而扩大。【丧尸威慑】可释放血脉威压，令低级丧尸产生恐惧甚至短暂臣服。【病毒抗性】对丧尸病毒有极高抗性，被咬伤后不会完全丧尸化，反而能吸收病毒特性强化自身。【异能觉醒】初期觉醒强化体质类异能，后期逐渐发展出更多能力。【秦帝血脉】远古帝王血脉，蕴含巨大潜力，需逐步觉醒解锁。",
      "role_type": "主角",
      "appearance": "身高一米七八，体态匀称偏瘦，面容清秀带着几分书卷气。黑色短发略显凌乱，眼神明亮而沉静。末日初期穿着普通大学生常服，后期逐渐换上便于行动的作战服，身上会随身携带一把军用匕首。感染丧尸病毒后，瞳孔偶尔会闪过一丝不易察觉的暗金色光芒，皮肤在情绪激动时会浮现淡淡的黑色纹路，这是丧尸特性觉醒的外在表现。",
      "background": "普通家庭出身，父母在他幼年时意外离世，由爷爷抚养长大。爷爷在他高考后不久也去世了，只留下一块祖传的黑色玉佩。目前是本市某大学计算机系大三学生，成绩中上，性格低调。与苏瑶从小一起长大，两人虽不同校但一直保持联系。末日爆发当天，他正在学校图书馆自习。",
      "personality": "外表温和内敛，内心坚韧执着。平时话不多，但关键时刻总能保持冷静做出正确判断。对朋友极其忠诚，尤其对苏瑶有着超越青梅竹马的深厚情感，只是自己尚未完全意识到。有强烈的责任感，随着能力觉醒逐渐展现出领袖气质，但始终保持谦逊。面对丧尸时会表现出异于常人的冷静，甚至有种莫名的熟悉感。",
      "current_goal": "在末日中保护苏瑶活下去，寻找安全的避难所，弄清楚自己身上发生的变异究竟是什么。",
      "first_chapter": 1,
      "current_status": "存活，处于丧尸病毒感染初期，异能刚刚觉醒。"
    },
    {
      "age": "23",
      "name": "苏瑶",
      "gender": "女",
      "skills": "【冰系异能】可操控冰元素进行攻击和防御，初期能制造冰锥、冰墙，后期可冻结大片区域。【医疗知识】医学院学生，具备基础医疗急救能力，末日中极为宝贵。【冷静判断】在危机中能保持冷静，多次在关键时刻做出正确决策。【战斗天赋】学习能力强，能快速掌握异能战斗技巧。",
      "role_type": "主角",
      "appearance": "身高一米六八，身材高挑纤细，长发常扎成干练的马尾。五官精致冷艳，眉眼间带着几分清冷疏离。平时穿着简约大方，末日后换上便于行动的深色衣物，腰间会别一把折叠刀。皮肤白皙，气质清冷如冰，但偶尔流露出的温柔眼神会让人感受到她内心的温暖。",
      "background": "比林轩大两岁的青梅竹马，目前是本市另一所大学医学院大四学生，成绩优异，原本计划考研深造。父母都是普通上班族，末日爆发时与父母失联，这是她心中最大的牵挂。从小就像姐姐一样照顾林轩，两人虽非情侣但关系比普通朋友更亲密。末日当天她恰好来林轩学校附近办事，因此得以第一时间找到林轩。",
      "personality": "外冷内热，表面清冷疏离，实则内心柔软细腻。对林轩有着超越姐弟的深厚感情，但习惯用严厉和唠叨来掩饰关心。做事果断利落，有很强的执行力和判断力。在末日中展现出惊人的适应能力和战斗天赋，冰系异能与她清冷的气质相得益彰。对陌生人保持警惕，但对认定的同伴极其忠诚。",
      "current_goal": "保护林轩安全，寻找失联的父母，在末日中建立稳定的生存基础。",
      "first_chapter": 1,
      "current_status": "存活，冰系异能觉醒初期，正陪伴林轩在校园中求生。"
    },
    {
      "age": "远古",
      "name": "秦始皇",
      "gender": "男",
      "skills": "【帝境修为】曾触及帝境边缘，拥有改天换地的恐怖力量。【阵法造诣】精通上古阵法，能在秦陵布下千年不衰的守护大阵。【血脉传承】可通过血脉将力量和记忆传递给后人。【文明守护】掌握着对抗境外敌人的关键秘密和方法。",
      "role_type": "配角",
      "appearance": "以记忆碎片或精神投影形式出现时，身着玄色龙袍，头戴十二旒冕冠，面容威严深邃，眼神中蕴含着跨越千年的沧桑与智慧。身形高大挺拔，即便只是虚影也散发着令人窒息的帝王威压。真实肉身状态未知，可能以某种特殊形式存在于秦陵深处。",
      "background": "千古一帝，统一六国建立第一个大一统王朝。在末法时代感知到未来有境外强敌入侵，为守护华夏文明尝试突破帝境失败，丧尸病毒是其失败产物。但他并未放弃，而是通过某种手段延缓了敌人入侵的时间，并在秦陵留下传承和布局。林轩是他血脉的延续，也是他计划中最关键的一环。",
      "personality": "雄才大略，深谋远虑，为达目的不惜一切代价。有着超越时代的远见和魄力，敢于挑战天地法则。对华夏文明有着深沉的热爱和守护之心，愿意为文明延续布局千年。性格复杂多面，既有帝王的冷酷决断，也有守护者的悲悯情怀。他的布局环环相扣，每一步都经过精心计算。",
      "current_goal": "通过林轩完成未竟的布局，彻底击退境外敌人，守护华夏文明延续。",
      "first_chapter": 251,
      "current_status": "以某种特殊形式存在于秦陵深处，肉身状态未知，精神力量可通过血脉影响后人。"
    },
    {
      "age": "22",
      "name": "陈锐",
      "gender": "男",
      "skills": "【火系异能】可操控火焰进行攻击，初期能发射火球，后期可形成火焰风暴。【强化体质】体育生出身，身体素质远超常人，耐力和力量突出。【近战格斗】擅长近身搏斗，配合异能战斗力强悍。【团队协作】善于配合队友，是队伍中可靠的突击手。",
      "role_type": "配角",
      "appearance": "身高一米八二，体格健壮结实，皮肤黝黑，面容刚毅带着几分憨厚。短寸头，眼神明亮有神，笑起来露出一口白牙。平时穿着运动装，末日后换上从军需库找到的迷彩作战服，背上常背着一把消防斧。身上有多处战斗留下的伤疤，是末日生存者的印记。",
      "background": "林轩的大学室友兼挚友，体育特长生，主修体育教育。家境普通，父母在外打工，从小独立生活。性格开朗外向，是宿舍里的开心果。末日爆发时正在操场跑步，凭借强健体魄侥幸逃脱。与林轩在校园重逢后，成为最坚定的战友。",
      "personality": "性格热血豪爽，讲义气重情义，是典型的行动派。对朋友极其忠诚，愿意为兄弟两肋插刀。战斗时勇猛无畏，有时会显得冲动，但在林轩的影响下逐渐学会思考。有强烈的责任感和保护欲，尤其对队伍中的弱者。末日让他快速成长，从普通大学生蜕变为可靠的战士。",
      "current_goal": "保护好林轩和避难所的同伴，在末日中活下去并找到生存的意义。",
      "first_chapter": 51,
      "current_status": "存活，火系异能觉醒，正跟随林轩在校园避难所中战斗。"
    },
    {
      "age": "20",
      "name": "赵薇薇",
      "gender": "女",
      "skills": "觉醒治愈系异能【生命共鸣】，可通过接触加速伤口愈合、缓解病痛、净化轻度感染。同时具备扎实的急救、外科包扎和药物知识，是避难所的“移动医疗站”。",
      "role_type": "配角",
      "appearance": "身材娇小，面容清秀，总是扎着利落的马尾，眼神专注而温柔。常穿着便于活动的浅色卫衣和牛仔裤，随身携带一个鼓鼓囊囊的医疗包。",
      "background": "医学院大二学生，主修临床医学，辅修护理学。父母是普通工薪阶层，从小成绩优异，立志成为一名优秀的医生。末日爆发时正在图书馆复习，凭借医学知识在混乱中保护了几个同学。",
      "personality": "外柔内刚，心思细腻，有强烈的责任感和同理心。面对伤患时冷静专业，但在安全环境下会流露出属于20岁女孩的活泼与俏皮。对林轩和苏瑶充满信任，是团队中不可或缺的粘合剂。",
      "current_goal": "在末日中尽可能多地救治伤员，守护身边人的生命，并希望找到父母的下落。",
      "first_chapter": 51,
      "current_status": "存活"
    },
    {
      "age": "45",
      "name": "王建国",
      "gender": "男",
      "skills": "顶尖的军事素养，精通战术指挥、野外生存、武器使用和近身格斗。觉醒强化系异能【钢铁之躯】，可短时间内大幅提升身体防御力和力量。",
      "role_type": "配角",
      "appearance": "身材魁梧挺拔，面容刚毅，留着标准的军人短寸头，眉宇间有深刻的皱纹。常穿着洗得发白的旧军装或迷彩作战服，行动间带着雷厉风行的军人作风。",
      "background": "某集团军侦察营营长，军龄超过二十年，参加过多次维和与反恐任务。末日爆发时正带队执行任务，在通讯中断、上级失联的情况下，带领残部收拢幸存者，试图建立安全区并等待国家指令。",
      "personality": "沉稳坚毅，原则性极强，有强烈的军人荣誉感和责任感。外表严肃，不苟言笑，但内心深处爱护士兵，重情重义。对国家和人民有着近乎信仰般的忠诚。",
      "current_goal": "维持部队建制，保护幸存者，寻找并重建与上级或国家指挥体系的联系，恢复秩序。",
      "first_chapter": 101,
      "current_status": "存活"
    },
    {
      "age": "55",
      "name": "李博士",
      "gender": "男",
      "skills": "拥有渊博的病毒学、遗传学、古生物学知识。虽无战斗异能，但其科学头脑是破解末日谜团的关键。后期通过研究，可能辅助开发出针对性药剂或设备。",
      "role_type": "配角",
      "appearance": "身材清瘦，戴着一副厚厚的黑框眼镜，头发花白且有些凌乱，眼神却锐利而专注。常穿着白大褂，口袋里插满各种笔和便签，手指因长期接触化学试剂而微微发黄。",
      "background": "国内顶尖病毒学家与遗传学权威，曾参与多项国家级生物安全项目。末日爆发前，他正在研究一种来源不明的古病毒样本（后证实与秦始皇布局相关）。末日爆发后，被军方保护并转移到军事基地，主持对丧尸病毒和异能现象的研究。",
      "personality": "典型的学者性格，理性、严谨、执着，甚至有些固执。对未知充满探索欲，将科学研究置于个人安危之上。不善交际，但对待研究成果和帮助过他的人异常真诚。",
      "current_goal": "彻底搞清楚丧尸病毒的起源、传播机制、变异规律以及异能觉醒的本质，为人类找到战胜末日的方法。",
      "first_chapter": 151,
      "current_status": "存活"
    },
    {
      "age": "30",
      "name": "周天浩",
      "gender": "男",
      "skills": "觉醒辅助系异能【精神暗示】，可对意志薄弱者进行低强度的精神干扰或诱导，增强自身言语的说服力。擅长权术、利益交换和煽动人心。",
      "role_type": "反派",
      "appearance": "身材中等，面容普通，但眼神总是闪烁着精明与算计。喜欢穿着相对整洁的名牌休闲装，在末日环境中显得格格不入。习惯性地微微昂着下巴，带着一种居高临下的姿态。",
      "background": "本市知名企业家之子，从小养尊处优，习惯用金钱和资源解决问题。末日爆发时，凭借家族保镖和囤积的物资，在校园内迅速拉拢了一批追随者，建立了以自己为核心的“浩哥帮”。",
      "personality": "自私、贪婪、野心勃勃，信奉“末日弱肉强食”的丛林法则。善于伪装和煽动，有一定组织能力，但心胸狭隘，嫉妒心强。将个人利益和权力欲置于集体生存之上。",
      "current_goal": "在末日中建立属于自己的势力，夺取更多资源和权力，成为一方霸主，绝不甘于屈居林轩等人之下。",
      "first_chapter": 51,
      "current_status": "存活"
    },
    {
      "age": "不详",
      "name": "黑袍使者",
      "gender": "男",
      "skills": "1. 丧尸共生控制：能同时与3-5只高级丧尸建立精神链接，指挥它们作战，并共享部分感官。2. 暗影潜行：可短暂融入阴影进行快速移动和突袭。3. 生命汲取：通过特殊仪式或直接接触，吸取他人（包括异能者和丧尸）的生命力来治愈自身或强化控制力。4. 毒素精通：擅长使用各种神经毒素和病毒变种。",
      "role_type": "反派",
      "appearance": "身形高大，常年笼罩在一件宽大破旧的黑色斗篷之下，兜帽深垂，只能看到下半张苍白如纸的脸和一抹诡异的紫色唇角。皮肤呈现出不自然的青灰色，手指修长，指甲尖锐且泛着金属般的冷光。",
      "background": "真实身份是境外敌对势力培养的顶尖特工，在末日爆发前就已潜伏在周边国家。他掌握着该势力独有的“丧尸共生技术”，能够与高级丧尸建立精神链接并进行一定程度的控制。他的任务是渗透并评估华夏大地的异能者实力，为全面入侵做准备，并寻找秦始皇布局的关键。",
      "personality": "冷酷、残忍且极具目的性。他视人类为实验品和资源，行事毫无道德底线，但对“主上”（境外敌对势力首领）表现出绝对的忠诚。他享受猎杀和掌控的快感，尤其喜欢折磨那些拥有强大异能的人类。",
      "current_goal": "渗透华夏腹地，寻找秦始皇布局的核心（如秦陵秘境），评估并清除潜在威胁（特别是林轩这样的特殊血脉者），为境外势力的全面入侵铺平道路。",
      "first_chapter": 301,
      "current_status": "存活（潜伏中）"
    },
    {
      "age": "不详",
      "name": "影王",
      "gender": "男",
      "skills": "1. 暗影支配：可操纵阴影进行攻击、防御和移动，甚至能短暂制造一片“暗影领域”。2. 超速再生：除非被瞬间彻底摧毁核心（位于胸腔的变异结晶），否则能快速再生受损躯体。3. 精神威慑：散发的精神压迫能令低阶丧尸臣服，并对弱小异能者造成恐惧和混乱。4. 骨刺触须：背部的触须可硬化如钢铁，用于穿刺、束缚和远程攻击，并能吸收接触目标的生命力。5. 战斗直觉：保留了生前的战斗本能，能快速分析对手弱点。",
      "role_type": "反派",
      "appearance": "身高接近三米，体型魁梧如小山，但动作异常敏捷。皮肤呈暗紫色，布满类似岩石裂纹的纹路，裂纹中隐隐有暗红色的光芒流动。面部特征已高度异化，双眼是纯粹的猩红色，没有瞳孔，口部裂开至耳根，露出层层叠叠的锋利獠牙。最显著的特征是其背部脊椎处延伸出数条由骨质和暗能量构成的、可自由伸缩的触须。",
      "background": "生前可能是一名特种部队成员或极限运动员，在感染丧尸病毒后，因其特殊的体质和强烈的求生/毁灭意志，发生了罕见的定向变异，保留了大部分智慧并获得了强大的暗影与力量异能。他是丧尸自然进化链条上的一个关键节点，其出现预示着丧尸群体开始出现有组织的威胁。他本能地被秦始皇血脉（林轩）的气息所吸引，既感到威胁，又渴望吞噬这份力量来完成自身的终极进化。",
      "personality": "拥有近乎人类的狡诈智慧，但思维模式更接近顶级掠食者。他保留了部分生前记忆碎片，对人类社会抱有扭曲的憎恨和蔑视。他极度渴望进化，吞噬其他强大丧尸和异能者是其本能。他行事谨慎，懂得策略性撤退和设伏，是丧尸中的“王者”。",
      "current_goal": "寻找并吞噬更多强大的能量源（尤其是林轩的秦始皇血脉力量），突破当前的生命形态限制，成为真正的“丧尸之神”，并建立属于自己的丧尸王国。",
      "first_chapter": 201,
      "current_status": "存活（游荡/狩猎中）"
    }
  ],
  "foreshadowing": [
    {
      "id": "F1",
      "content": "林轩被丧尸咬伤后伤口愈合速度异常，且对丧尸有莫名的亲切感。",
