  "micro": {
    "micro_scenes": [
      {
        "id": "micro_1_1_1",
        "pov": "苏晚",
        "hook": "手机屏幕暗下去，苏晚抬起头，看到一个男人从便利店走出来——她不知道这个人将改变她的一生",
        "name": "被驱逐的少女",
        "outcome": "苏晚在便利店门口避雨，在神待少女论坛发布求助帖，但无人回应",
        "conflict": "苏晚被父亲新家庭彻底驱逐，银行卡被冻结，身无分文，面临流落街头的绝境",
        "location": "便利店门口",
        "characters": [
          "苏晚",
          "苏晚的父亲（电话中）"
        ],
        "emotion_tone": "绝望、孤独",
        "scene_number": 1,
        "meso_stage_id": "meso_1_1",
        "chapter_number": 1,
