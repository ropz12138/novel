      "title": "她的庇护所",
      "volume": "第一卷：不速之客"
    },
    "ending": {
      "direction": "男主与女学生共同面对过去，找到救赎与新生，关系从交易升华为相互依存的羁绊"
    },
    "macro_phases": [
      {
        "id": "P1",
        "goal": "男主接纳女学生入住，建立初步信任与同居关系",
        "name": "不请自来",
        "core_setting": "男主隐退杀手身份与孤独生活，女学生以神待少女方式换取庇护，两人各怀心事却形成微妙平衡",
        "chapter_range": [
          1,
          15
        ]
      },
      {
        "id": "P2",
        "goal": "男主发现女学生身上的异常，开始调查她的过去",
        "name": "暗流涌动",
        "core_setting": "女学生隐藏的秘密逐渐浮出水面，男主被迫动用过去的技能与人脉，同时外部势力开始逼近",
        "chapter_range": [
          16,
          35
        ]
      },
      {
        "id": "P3",
        "goal": "男主的杀手身份被揭露，与过去的敌人正面交锋",
        "name": "旧影重现",
        "core_setting": "男主过去的组织或仇家找上门，女学生的真实身份与男主的过去产生交集，两人关系面临考验",
        "chapter_range": [
          36,
          55
        ]
      },
      {
        "id": "P4",
        "goal": "共同对抗外部威胁，保护彼此",
        "name": "绝境求生",
        "core_setting": "男主与女学生联手对抗共同的敌人，在生死考验中建立真正的信任与羁绊",
        "chapter_range": [
          56,
          75
        ]
      },
      {
        "id": "P5",
        "goal": "解决所有危机，找到新的生活方向",
        "name": "破晓时分",
        "core_setting": "真相大白，所有威胁解除，男主与女学生重新定义彼此的关系，找到继续前行的理由",
        "chapter_range": [
          76,
          90
        ]
      }
    ],
    "core_characters": [
      {
        "name": "林默",
        "brief": "隐退的顶尖杀手，因过去的阴影选择孤独生活，内心渴望救赎",
