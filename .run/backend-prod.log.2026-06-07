  "characters": [
    {
      "age": "",
      "name": "林默",
      "gender": "",
      "skills": "顶尖的格斗与反侦察技巧，对危险有着野兽般的直觉，擅长使用冷兵器。精通简单的医疗急救（为了处理自己的伤口），生活技能原本极差，但在苏小雨的影响下开始学习做饭。拥有极强的逻辑思维和心理素质。",
      "role_type": "男主",
      "appearance": "身高约一米八二，身材精瘦但肌肉线条分明，常年穿着深色休闲装或旧卫衣，试图掩盖身上凌厉的气质。面容冷峻英俊，眉骨很高，眼神深邃且常年透着警惕，左眉梢有一道极淡的旧疤痕。平时总是戴着一副黑框眼镜，试图让自己显得斯文无害，但一旦眼神聚焦，仍会让人感到无形的压迫感。",
      "background": "曾是地下世界令人闻风丧胆的顶尖杀手，代号“默”。因厌倦了无尽的杀戮与背叛，在一次任务中假死脱身，隐姓埋名来到这座海滨小城。靠早年的积蓄过着深居简出的生活，试图在孤独中洗刷双手沾满的鲜血。过去的身份像一颗定时炸弹，让他时刻处于紧绷状态。",
      "personality": "外冷内热，患有严重的失眠症和轻度PTSD。生活极度自律且枯燥，有着近乎强迫症般的整理习惯。对陌生人充满戒备，不善言辞，习惯用沉默应对一切。内心深处保留着极高的道德底线，厌恶杀戮，渴望救赎。对待苏小雨从最初的冷漠排斥，逐渐转变为笨拙但深沉的父爱式关怀。",
      "current_goal": "保护苏小雨不被卷入自己的过去，维持现有的平静生活，并尝试学会如何像普通人一样去爱与生活。",
      "first_chapter": 1,
      "current_status": "存活，处于隐居状态"
    },
    {
      "age": "",
      "name": "苏小雨",
      "gender": "",
      "skills": "生活技能满点，擅长烹饪、缝补和收纳，能把杂乱的房间打理得井井有条。学习能力极强，即使在恶劣环境下成绩依然名列前茅。拥有很强的抗压能力和同理心。",
      "role_type": "女主",
      "appearance": "身高一米六左右，身形纤细瘦弱，看起来营养不良。拥有一头乌黑柔顺的长发，常扎成简单的马尾。五官精致清秀，皮肤白皙得近乎透明，一双大眼睛清澈明亮，笑起来时会弯成月牙，但眼底偶尔会流露出与年龄不符的沧桑。衣着朴素干净，总是洗得发白的校服或简单的棉布裙。",
      "background": "原本成绩优异的高中生，因父亲酗酒家暴、母亲离家出走而陷入绝境。在父亲欠下巨额赌债后，为了不被卖掉，她被迫离家出走。为了筹集学费和生存，她不得不以“神待少女”的方式在街头寻求陌生人的收留，直到遇见了林默。",
      "personality": "坚韧乐观，像石缝里顽强生长的杂草。虽然命运多舛，但从未放弃对美好生活的向往。心思细腻敏感，非常懂得察言色，擅长做家务和照顾人。自尊心极强，不愿接受施舍，坚持用劳动换取报酬。渴望拥有一个真正的家，对林默既依赖又敬畏，是治愈林默内心创伤的阳光。",
      "current_goal": "努力读书考上大学，回报林默的收留之恩，希望能和林默组建一个真正的家庭，拥有平凡幸福的人生。",
      "first_chapter": 1,
      "current_status": "存活，借住在林默家"
    },
    {
      "age": "",
      "name": "张老师",
      "gender": "",
      "skills": "丰富的教学经验和学生心理辅导能力，擅长与家长沟通。拥有广泛的社会资源和人脉，能够在必要时为学生争取帮助。",
      "role_type": "配角",
      "appearance": "四十岁左右的中年女性，身材微胖，总是戴着一副金丝边眼镜。面容慈祥和蔼，眼角有着岁月留下的笑纹。穿着得体大方，通常是衬衫搭配过膝裙，手里总是拿着教案或保温杯。给人的感觉像邻家阿姨般亲切温暖。",
      "background": "在教育一线工作了二十年的老教师，见惯了各种家庭背景的学生。深知原生家庭对孩子的影响，因此对苏小雨这样家庭异常的学生格外关注。自己也有一个正在上大学的儿子，因此更能理解青春期孩子的心理需求。",
      "personality": "责任心极强，对学生有着母亲般的关爱。眼光敏锐，善于观察学生的情绪变化。为人正直但不死板，懂得变通，为了保护学生可以适当打破规则。富有同情心，但也能坚守原则，是典型的严师慈母形象。",
      "current_goal": "帮助苏小雨顺利完成学业，引导她健康成长，同时作为林默的监督者，确保苏小雨得到妥善照顾。",
      "first_chapter": 1,
      "current_status": "存活，在职教师"
    },
    {
      "age": "",
      "name": "老陈",
      "gender": "",
      "skills": "情报收集与分析大师，擅长心理博弈和谈判。拥有庞大的人脉网络和资源调动能力。枪法精湛，格斗技巧不输当年。",
      "role_type": "配角",
      "appearance": "五十岁上下，身材保持得很好，依然挺拔。头发花白但梳得一丝不苟，穿着考究的定制西装，手腕上戴着名表。面容精瘦，眼神锐利如鹰，嘴角总是挂着若有若无的笑意，但那笑容并不达眼底。整体给人一种精明强干、深不可测的感觉。",
      "background": "林默在组织中的引路人兼搭档，曾一起执行过多次高难度任务。在林默假死后接管了部分势力，如今是地下世界举足轻重的人物。此次前来，一方面是受组织委托追查林默下落，另一方面也是想亲眼确认老搭档的现状。",
      "personality": "城府极深，老谋深算。对林默有着复杂的感情，既是曾经生死与共的搭档，又是利益至上的合作者。信奉丛林法则，认为林默的隐退是暴殄天物。做事不择手段，但对林默还保留着最后一丝情义，不愿看到他堕落，希望他能重振雄风。",
      "current_goal": "试探林默的态度，评估他是否对组织构成威胁，同时试图利用林默的软肋（苏小雨）逼迫他重出江湖，或者彻底铲除隐患。",
      "first_chapter": 1,
      "current_status": "存活，活跃于地下世界"
    }
  ],
  "foreshadowing": [],
  "character_links": []
}
