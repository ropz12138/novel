    "core_characters": [
      {
        "name": "萧夜",
        "brief": "前杀手，24岁，因搭档之死隐退，冷漠寡言却以规则之名守护苏晚，在赎罪中重新学会温度",
        "role_type": "男主"
      },
      {
        "name": "苏晚",
        "brief": "17岁高三生，被家庭抛弃却不肯向命运低头，用坚硬外壳包裹渴望被爱的心，以神待少女身份闯入萧夜的世界",
        "role_type": "女主"
      },
