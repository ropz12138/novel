{
  "meso": {
    "meso_stages": [
      {
        "id": "M1_1",
        "name": "雨夜收留",
        "type": "感情阶段",
        "cause": "陆沉深夜在公寓附近发现淋雨发烧的苏晚，出于本能将她带回家，发现她身无分文且无处可去",
        "twist": "陆沉并未接受苏晚的提议，而是提出以做家务换取食宿的协议",
