        "name": "共同新生",
        "core_setting": "男主用新身份保护女孩，女孩用温暖治愈男主的创伤，两人建立真正的家人关系",
        "chapter_range": [
          101,
          120
        ],
        "ending_direction": "温馨结局，两人成为彼此的依靠"
      }
