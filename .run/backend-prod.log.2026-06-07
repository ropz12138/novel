完整大纲：
{
  "meso": {
    "meso_stages": [
      {
        "id": "meso_1_1",
        "name": "雨夜相遇",
        "summary": "暴雨夜，苏晚拖着行李箱站在便利店门口，手机屏幕上「神待少女」论坛的回复列表一片灰暗。她刚被父亲的新家庭彻底驱逐，银行卡被冻结，身上只剩三百日元。萧夜采购完一周物资走出便利店，与苏晚擦肩而过时被她拉住衣角。苏晚颤抖着说出那句她在论坛上练习了无数遍的话：「能让我住一晚吗？」萧夜冷漠地抽回衣角，却在走出三步后停下，回头看了她一眼。",
        "key_events": [
          "苏晚在便利店门口发布神待少女求助帖无人回应",
          "父亲的最后一通电话：别再回来了",
          "萧夜与苏晚在雨中的便利店门口相遇",
          "苏晚拉住萧夜衣角发出请求",
          "萧夜短暂犹豫后默许苏晚跟随"
        ],
        "chapter_range": [
          1,
          1
        ],
        "emotional_arc": "绝望→孤注一掷→微弱的希望",
        "macro_phase_id": "P1",
        "participating_characters": [
          "萧夜",
          "苏晚",
          "苏晚的父亲（电话中）"
        ]
      },
      {
        "id": "meso_1_2",
        "name": "顶楼规则",
        "summary": "萧夜带苏晚回到老旧公寓顶层，房间简陋却异常整洁。萧夜拿出一张手写清单放在桌上：不许进他房间、不许碰窗台下的柜子、每周五晚八点前必须回来。苏晚注意到清单上没有「不许离开」这一条。萧夜说：「你随时可以走。」苏晚反问：「那你为什么让我来？」萧夜没有回答，转身回了自己房间。苏晚在客厅沙发上蜷缩一夜，听着窗外的雨声，第一次感到安全。",
        "key_events": [
          "萧夜带苏晚穿过昏暗的公寓楼道",
          "苏晚第一次看到萧夜房间内的简朴与异常整洁",
          "萧夜手写规则清单，逐条说明",
          "苏晚发现规则中没有禁止离开的条款",
          "苏晚在沙发上度过第一个夜晚，感到久违的安全"
        ],
        "chapter_range": [
          2,
          3
        ],
        "emotional_arc": "警惕→试探→微妙的安心",
        "macro_phase_id": "P1",
        "participating_characters": [
          "萧夜",
          "苏晚"
        ]
      },
      {
        "id": "meso_1_3",
        "name": "契约之夜",
        "summary": "入住第三天，苏晚发现萧夜每周五晚固定外出，凌晨才归。她趁萧夜不在偷偷观察房间，在窗台下柜子缝隙中瞥见金属光泽——被油布包裹的枪械轮廓。她迅速关上柜门，心跳如鼓。周五晚上，萧夜回来时发现苏晚还没睡，坐在沙发上等他。苏晚说：「我想和你做个交易。」她提出以做家务和保密为交换，换取长期借住。萧夜沉默良久，最终点头。两人之间第一份不成文的契约就此成立。",
        "key_events": [
          "苏晚发现萧夜每周五固定外出的规律",
          "苏晚偷看窗台下柜子发现武器",
          "苏晚决定主动提出交易而非逃离",
          "萧夜深夜归来发现苏晚在等他",
          "两人达成不成文的同居契约"
        ],
        "chapter_range": [
          4,
          5
        ],
        "emotional_arc": "好奇→震惊→决断→契约达成的微妙平衡",
        "macro_phase_id": "P1",
        "participating_characters": [
          "萧夜",
          "苏晚"
        ]
      },
      {
        "id": "meso_1_4",
        "name": "第一个周末",
        "summary": "契约成立后的第一个周末，苏晚用萧夜给的钱去超市采购食材，笨拙地做了第一顿饭。萧夜看着桌上卖相糟糕的蛋炒饭，沉默地吃完了全部。苏晚试探性地问起他的工作，萧夜只说了两个字：「保密。」傍晚，苏晚在阳台上晾衣服时哼起一首老歌，萧夜在屋内听到旋律，手指不自觉地跟着节奏轻敲桌面——那是搭档生前最喜欢的歌。他没有告诉苏晚。",
        "key_events": [
          "苏晚第一次为萧夜做饭",
          "萧夜吃完所有饭菜但不置一词",
          "苏晚试探萧夜职业被拒",
          "苏晚晾衣时哼唱老歌",
          "萧夜听到旋律后罕见的情感波动"
        ],
        "chapter_range": [
          6,
          6
        ],
        "emotional_arc": "生疏→笨拙的温暖→隐秘的共鸣",
        "macro_phase_id": "P1",
        "participating_characters": [
          "萧夜",
          "苏晚",
          "萧夜的搭档（暗线/回忆中的旋律）"
        ]
      },
      {
        "id": "meso_2_1",
        "name": "双线日常",
        "summary": "苏晚回到学校，面对高三的学业压力和同学的窃窃私语。她的突然「消失」和重新出现引发了各种猜测，有人传言她被包养。苏晚选择无视，每天放学后准时回到公寓。萧夜白天几乎不出门，但会在苏晚放学的时间点站在窗边。苏晚逐渐摸清萧夜的习惯：他睡眠极浅、对突然的声响反应过度、从不背对门口坐。她开始默默调整自己的行为——关门更轻、走路更缓、说话前先让他看到自己。",
        "key_events": [
          "苏晚回校后遭遇同学的排挤与流言",
          "萧夜在苏晚放学时间固定出现在窗边",
          "苏晚观察到萧夜的PTSD症状",
          "苏晚开始主动调整行为以适应萧夜",
          "两人形成无声的日常默契"
        ],
        "chapter_range": [
          7,
          9
        ],
        "emotional_arc": "孤立→观察→理解→默契的萌芽",
        "macro_phase_id": "P2",
        "participating_characters": [
          "萧夜",
          "苏晚"
        ]
      },
      {
        "id": "meso_2_2",
        "name": "深夜对白",
        "summary": "某个深夜，苏晚被噩梦惊醒，梦到父亲把她推出家门的场景。她走到厨房喝水，发现萧夜也没睡，坐在黑暗中。两人第一次在深夜交谈。苏晚问萧夜为什么总是不睡觉，萧夜反问：「你呢？」苏晚说了梦的内容，萧夜听完沉默了很久，说了一句：「有些人没有做父母的资格。」这句话让苏晚愣住——这是第一次有人站在她这边。她没有追问萧夜的过去，但两人的距离在黑暗中拉近了一步。",
        "key_events": [
          "苏晚被关于父亲的噩梦惊醒",
          "发现萧夜深夜未眠坐在黑暗中",
          "两人第一次深夜交谈",
          "苏晚讲述被父亲抛弃的经历",
          "萧夜说出那句让苏晚愣住的话"
        ],
        "chapter_range": [
          10,
          11
        ],
        "emotional_arc": "恐惧→倾诉→被理解→情感破冰",
        "macro_phase_id": "P2",
        "participating_characters": [
          "萧夜",
          "苏晚"
        ]
      },
      {
        "id": "meso_2_3",
        "name": "周五的暗面",
        "summary": "又到周五，苏晚假装睡着，等萧夜出门后悄悄跟踪。她看到萧夜进入城市边缘一家地下拳馆，两小时后浑身淤青地出来，手里多了一个信封。苏晚先一步跑回公寓，假装什么都没发生。萧夜回来后直接进了房间，苏晚听到他在处理伤口时压抑的闷哼。她最终鼓起勇气敲了萧夜的门，递上医药箱。萧夜看着她手中的医药箱，第一次没有拒绝她的靠近。",
        "key_events": [
          "苏晚跟踪萧夜发现地下拳馆",
          "目睹萧夜用搏命方式换取现金",
          "苏晚先跑回家假装不知情",
          "听到萧夜处理伤口时的闷哼",
          "苏晚递医药箱，萧夜第一次接受她的帮助"
        ],
        "chapter_range": [
          12,
          14
        ],
        "emotional_arc": "疑虑→震惊→心疼→主动靠近被接纳",
        "macro_phase_id": "P2",
        "participating_characters": [
          "萧夜",
          "苏晚"
        ]
      },
      {
        "id": "meso_2_4",
        "name": "学校风暴",
        "summary": "学校里的流言升级为实质性的霸凌。苏晚的课桌被刻上侮辱性字眼，课本被丢进垃圾桶。班主任找她谈话，暗示她「注意个人作风」。苏晚在厕所隔间里无声哭泣，然后擦干眼泪回到教室。她没有告诉萧夜，但萧夜从她红肿的眼眶和撕坏的校服袖口察觉了异常。第二天，苏晚发现课桌被清理干净，没有人再敢动她的东西。她不知道萧夜做了什么，只知道那天他出门的时间比平时早了三个小时。",
        "key_events": [
          "苏晚遭遇升级的校园霸凌",
          "班主任的偏见谈话让苏晚更加孤立",
          "苏晚独自消化情绪不告诉萧夜",
          "萧夜察觉异常后暗中出手",
          "校园霸凌莫名平息"
        ],
        "chapter_range": [
          15,
          16
        ],
        "emotional_arc": "压抑→崩溃→被暗中守护→无声的感动",
        "macro_phase_id": "P2",
        "participating_characters": [
          "萧夜",
          "苏晚"
        ]
      },
      {
        "id": "meso_2_5",
        "name": "生日",
        "summary": "苏晚的十八岁生日，她自己都忘了。放学回到公寓，发现桌上放着一块小蛋糕，上面插着一根蜡烛。萧夜不在，但蛋糕旁有一张便签：「冰箱里有菜。」苏晚打开冰箱，里面是萧夜提前做好的几道菜。她坐在桌前，对着蛋糕哭了很久。萧夜回来时她已经收拾好情绪，但眼眶的红骗不了人。萧夜什么也没说，只是在她对面坐下，等她吹蜡烛。这是苏晚人生中第一个有人陪伴的生日。",
        "key_events": [
          "苏晚忘记自己的十八岁生日",
          "回家发现萧夜准备的蛋糕和饭菜",
          "苏晚独自对着蛋糕哭泣",
          "萧夜回来默默陪她吹蜡烛",
          "苏晚人生中第一个被庆祝的生日"
        ],
        "chapter_range": [
          17,
          18
        ],
        "emotional_arc": "遗忘→惊喜→感动→被珍视的温暖",
        "macro_phase_id": "P2",
        "participating_characters": [
          "萧夜",
          "苏晚"
        ]
      },
      {
        "id": "meso_3_1",
        "name": "不速之客",
        "summary": "深夜，急促的敲门声打破了公寓的平静。萧夜开门后，一个浑身是血的中年男人跌进屋内——老陈，萧夜在旧组织时的联络人。老陈腹部中枪，意识模糊。萧夜脸色骤变，迅速检查门外后锁门。苏晚被惊醒，看到客厅里的血和陌生人，本能地后退。萧夜命令她回房间，但苏晚看到萧夜处理伤口时颤抖的手，第一次违抗了他的命令——她走过去，按住了老陈的伤口。",
        "key_events": [
          "老陈负伤深夜闯入公寓",
          "萧夜紧急处理伤口并封锁现场",
          "苏晚第一次看到萧夜面对危机时的专业反应",
          "苏晚违抗萧夜命令主动帮忙",
          "三人共处一室的紧张夜晚"
        ],
        "chapter_range": [
          19,
          21
        ],
        "emotional_arc": "平静→震惊→恐惧→违抗恐惧的勇气",
