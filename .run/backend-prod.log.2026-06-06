  "outline": {
    "story": {
      "genre": "末日丧尸异能",
      "title": "丧尸纪元：秦皇后裔",
      "volume": "第一卷：初临末世"
    },
    "ending": {
      "tags": [
        "末日",
        "丧尸",
        "异能",
        "秦始皇",
        "大学生",
        "长篇",
        "热血",
        "成长"
      ],
      "direction": "林默突破至准帝境后，选择融合丧尸病毒与人类文明，创造新种族。他成为新纪元的守护者，人类与丧尸和平共存，共同对抗境外威胁。苏晴成为新种族的精神领袖，两人携手开创未来。秦始皇的布局最终完成，但林默走出了自己的道路。",
      "foreshadowing": [
        {
          "id": "F1",
          "name": "林家古籍的秘密",
          "setup": "林默家传古籍中记载着模糊的家族历史，提到祖先曾是帝王近臣，但关键几页被人为撕毁。林默父亲临终前嘱咐他永远不要去西安。",
          "payoff": "在秦陵入口，林默发现被撕毁的几页其实是秦始皇后裔的族谱，他的名字赫然在列。父亲的嘱咐是为了保护他不被秦陵的守护者发现。",
          "reveal_chapter": 185
        },
        {
          "id": "F2",
          "name": "苏明远的研究发现",
          "setup": "苏晴父亲苏明远在病毒爆发前就神秘失踪，留下大量加密的研究笔记。笔记中反复出现一个符号，与秦始皇时期的某种祭祀图案相似。",
          "payoff": "林默在秦陵中发现同样的符号，苏明远早已发现丧尸病毒与秦始皇的关联，他的失踪是因为被秦陵的守护者白起带走，以保护他的研究成果不被境外势力获取。",
          "reveal_chapter": 220
        },
        {
          "id": "F3",
          "name": "秦雨的真实身份",
          "setup": "秦雨多次在关键时刻出现帮助林默，她对秦陵的熟悉程度远超常人，且能使用一种古老的战斗技巧。她声称自己是秦始皇后裔，但林默的血脉检测显示她与自己并无血缘关系。",
          "payoff": "秦雨是秦始皇用特殊方法制造的守护者，她的真实身份是秦始皇的妃子转世，被赋予守护后裔的使命。她帮助林默是因为感应到了秦始皇血脉的觉醒。",
          "reveal_chapter": 350
        },
        {
          "id": "F4",
          "name": "教会势力的秘密",
          "setup": "一个名为新黎明教会的组织在末日中迅速崛起，他们宣扬丧尸是神罚，主张净化一切感染者。教会高层对秦陵的位置异常关注。",
          "payoff": "新黎明教会实际上是境外入侵者在人类社会中的代理人，他们的目的是获取秦陵中的能量核心，为境外入侵者打开维度通道。教会高层中潜伏着影魔。",
          "reveal_chapter": 380
        },
        {
          "id": "F5",
          "name": "丧尸等级与秦陵能量场",
          "setup": "林默发现丧尸的等级分化与地理位置有关，离秦陵越近，高等丧尸出现的概率越高。秦陵周围的丧尸似乎在守护着什么。",
          "payoff": "秦陵的能量场是秦始皇突破失败时泄露的能量，这种能量与丧尸病毒结合，形成了丧尸的等级分化系统。高等丧尸实际上是被能量场强化的古代士兵遗骸。",
          "reveal_chapter": 250
        },
        {
          "id": "F6",
          "name": "病毒与血脉的共鸣",
          "setup": "林默在情绪激动时会进入一种特殊状态，他的血液会发出微光，周围的丧尸会暂时停止攻击。这种状态与他在古籍中看到的帝王觉醒描述相似。",
          "payoff": "林默体内的丧尸病毒与秦始皇的血脉产生了共鸣，这种共鸣是秦始皇设计的继承人选拔机制。只有血脉与病毒完美融合的后裔，才能获得操控丧尸军团的能力。",
          "reveal_chapter": 280
        },
        {
          "id": "F7",
          "name": "秦陵入口的位置",
          "setup": "白起多次暗示秦陵的入口不在骊山，而是在一个意想不到的地方。林默注意到每次提到秦陵，白起都会看向北方。",
          "payoff": "真正的秦陵入口位于林默的家乡，一个被遗忘的古代军事要塞。秦始皇为了保护陵墓，将入口设置在自己的故乡，只有血脉后裔才能感应到确切位置。",
          "reveal_chapter": 195
        },
        {
          "id": "F8",
          "name": "影魔的潜伏身份",
          "setup": "一个在军方情报部门工作的神秘人物多次向林默提供关键情报，但他总是避免露面。他的代号是暗影，对林默的行踪了如指掌。",
          "payoff": "暗影就是影魔，他潜伏在人类社会中是为了监视秦始皇后裔的动向。他提供情报是为了引导林默走向秦陵，因为境外入侵者需要秦陵的能量核心来打开维度通道。",
          "reveal_chapter": 400
        },
        {
          "id": "F9",
          "name": "林默父亲的遗物",
          "setup": "林默父亲留给他一块看似普通的玉佩，玉佩在林默觉醒异能后开始发热。玉佩上刻着一个模糊的图案。",
          "payoff": "玉佩是秦始皇留下的血脉验证器，图案是秦陵的钥匙。只有将玉佩与秦陵入口的机关结合，才能打开真正的秦始皇陵墓。",
          "reveal_chapter": 210
        },
        {
          "id": "F10",
          "name": "苏晴异能的特殊性",
          "setup": "苏晴的治愈系异能不仅能治愈伤势，还能暂时净化丧尸病毒。她的异能觉醒时，周围的植物异常茂盛。",
          "payoff": "苏晴的异能实际上是一种生命能量操控能力，这种能力与秦始皇突破时使用的长生不老药有关。她是秦始皇布局中关键的一环，能够平衡林默体内的丧尸病毒。",
          "reveal_chapter": 320
        }
      ]
    },
    "macro_phases": [
      {
        "id": "P1",
        "goal": "男主林默在丧尸爆发初期被咬感染，经历生死危机后觉醒异能，与青梅竹马苏晴汇合，组建初期幸存者小队",
        "name": "末日降临·觉醒异变",
        "core_setting": "末日爆发初期，城市陷入混乱，丧尸病毒快速蔓延。林默被咬后未完全丧尸化，反而觉醒了感知丧尸、强化体质等异能，但需隐藏自己被感染的事实。苏晴从南方艺术学院北上寻找林默，途中展现领导能力。林默父亲遗留的玉佩开始发热，古籍中的秘密初现端倪。",
        "chapter_range": [
          1,
          80
        ],
        "ending_direction": "林默异能初步稳定，与苏晴重逢，小队初具雏形，但林默发现自己能隐约感知到某种古老召唤，玉佩上的图案在月光下若隐若现"
      },
      {
        "id": "P2",
        "goal": "小队在城市废墟中生存壮大，遭遇其他幸存者势力，发现丧尸变异规律，林默异能进阶",
        "name": "势力割据·暗流涌动",
        "core_setting": "各大城市出现不同幸存者势力割据，军方、民间组织、新黎明教会、神秘势力并存。林默发现丧尸存在等级分化，高等丧尸拥有智慧。林默的丧尸能力逐渐增强，能短暂控制低等丧尸，但副作用是偶尔失去理智。苏晴觉醒治愈系异能，她的异能能暂时净化丧尸病毒。苏明远的研究笔记被发现，其中反复出现秦始皇时期的祭祀符号。",
        "chapter_range": [
          81,
          180
        ],
        "ending_direction": "林默身份险些暴露，被迫离开人类聚居地，与苏晴等人进入未知区域。苏明远的笔记指向秦陵，林默决定前往寻找真相"
      },
      {
        "id": "P3",
        "goal": "林默一行前往秦始皇陵寻找丧尸病毒真相，林默血脉完全觉醒，揭开秦始皇布局",
        "name": "秦陵秘辛·血脉觉醒",
        "core_setting": "林默通过古籍和苏明远的研究笔记发现丧尸病毒与秦始皇有关。白起出现，引导他们前往真正的秦陵入口。在秦陵深处发现秦始皇留下的信息：病毒是突破失败的产物，但也是对抗境外入侵者的屏障。林默血脉觉醒，获得操控丧尸军团的能力。秦雨多次出现帮助林默，她对秦陵的熟悉程度远超常人。林默发现丧尸等级分化与秦陵能量场的关联。",
        "chapter_range": [
          181,
          300
        ],
        "ending_direction": "林默得知自己肩负使命，但境外入侵者已开始渗透。秦雨的真实身份成谜，她声称是秦始皇后裔但与林默无血缘关系"
      },
      {
        "id": "P4",
        "goal": "林默组建丧尸军团对抗境外入侵势力，人类与丧尸首次合作",
        "name": "境外入侵·丧尸军团",
        "core_setting": "境外入侵者是来自异维度的生物，以人类灵魂为食。林默利用秦始皇留下的方法强化丧尸军团，但人类内部对与丧尸合作存在巨大分歧。新黎明教会公开反对林默，主张彻底消灭丧尸。苏晴成为人类与丧尸沟通的桥梁，她的生命能量操控能力逐渐显现。林默逐渐掌控丧尸病毒，能将其转化为己用。影魔潜伏在人类社会中，多次向林默提供关键情报。",
        "chapter_range": [
          301,
          420
        ],
        "ending_direction": "首次大规模战役胜利，但林默发现秦始皇的真正目的远不止于此。新黎明教会与境外入侵者的联系逐渐浮出水面"
      },
      {
        "id": "P5",
        "goal": "林默突破至准帝境，面临成为新帝或毁灭病毒的终极抉择",
        "name": "帝境之路·终极抉择",
        "core_setting": "林默发现秦始皇的布局是培养继承人突破帝境，彻底消灭境外威胁。但突破需要牺牲大量丧尸生命。人类、丧尸、境外势力三方博弈。苏晴等人支持林默，但部分人类势力想要彻底消灭丧尸。林默在突破过程中领悟秦始皇的真正意图。秦雨揭示自己的真实身份，她是秦始皇的妃子转世，被赋予守护后裔的使命。影魔的真实身份暴露，他是境外入侵者在人类社会中的代理人。",
        "chapter_range": [
          421,
          550
        ],
        "ending_direction": "林默做出自己的选择，融合丧尸病毒与人类文明，创造新种族。他成为新纪元的守护者，人类与丧尸和平共存，共同对抗境外威胁。苏晴成为新种族的精神领袖，两人携手开创未来。秦始皇的布局最终完成，但林默走出了自己的道路"
      }
    ],
    "core_characters": [
      {
        "name": "林默",
        "brief": "22岁北方大学生，秦始皇后裔，被丧尸咬伤后觉醒异能，能操控丧尸，肩负对抗境外入侵者的使命。父亲遗留的玉佩是秦陵的钥匙，古籍中记载着家族秘密。",
        "role_type": "主角"
      },
      {
        "name": "苏晴",
        "brief": "24岁南方艺术学院学生，林默青梅竹马，觉醒治愈系异能，能暂时净化丧尸病毒。父亲苏明远是古生物学家，研究丧尸病毒起源的科学家，已神秘失踪。",
        "role_type": "女主"
      },
      {
