        "role_type": "幕后"
      },
      {
        "name": "陈昊",
        "brief": "林默大学室友，觉醒力量型异能，忠诚可靠的战友。",
        "role_type": "队友"
      },
      {
        "name": "林雪",
        "brief": "林默妹妹，16岁高中生，觉醒植物操控异能，性格活泼。",
