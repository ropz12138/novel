  "story": {
    "genre": "末日丧尸异能",
    "title": "丧尸纪元：始皇血脉",
    "volume": "第一卷：末日降临"
  },
  "outline": {
    "story": {
      "genre": "末日丧尸异能",
      "title": "丧尸纪元：始皇血脉",
      "volume": "第一卷：末日降临"
    },
    "ending": {
      "direction": "林渊完全觉醒始皇血脉，继承始皇遗志，彻底净化丧尸病毒，击退境外势力入侵，带领华夏幸存者重建文明，开创人类新纪元。他与苏晚晴的感情也在末日考验中得到升华，两人共同守护新生的人类文明。"
    },
    "macro_phases": [
      {
        "id": "P1",
        "goal": "主角在丧尸危机爆发后生存下来，被咬后在女主陪伴下觉醒异能，组建初期幸存者小队",
        "name": "末日降临与觉醒",
        "core_setting": "现代都市突然爆发丧尸病毒，主角林渊被咬后未变异，反而觉醒了吸收丧尸能力的特殊异能。青梅竹马苏晚晴是他的精神支柱",
        "chapter_range": [
          1,
          50
        ],
        "ending_direction": "林渊觉醒异能，与苏晚晴带领小队离开校园，前往城市避难所"
      },
      {
        "id": "P2",
        "goal": "在城市废墟中建立据点，探索丧尸变异规律，发现异能觉醒者的秘密",
        "name": "城市废墟求生",
        "core_setting": "丧尸开始出现等级分化，普通丧尸进化为变异体。人类幸存者建立临时据点，但资源争夺引发内部冲突",
        "chapter_range": [
          51,
          120
        ],
        "ending_direction": "林渊击败据点内的叛乱者，获得领导地位，发现丧尸病毒似乎有某种规律性"
      },
      {
        "id": "P3",
        "goal": "接触其他幸存者势力，发现丧尸病毒爆发并非偶然，开始追寻病毒起源",
        "name": "势力纷争与真相初现",
        "core_setting": "各大幸存者势力崛起，军方、民间组织、神秘势力相互角力。林渊的异能引起各方关注，同时他发现自己的血脉似乎与丧尸病毒有某种联系",
        "chapter_range": [
          121,
          200
        ],
        "ending_direction": "林渊从古籍中发现秦始皇的记载，开始怀疑病毒起源与历史有关"
      },
      {
        "id": "P4",
        "goal": "探索始皇遗迹，觉醒秦始皇血脉，揭开丧尸病毒起源的第一层面纱",
        "name": "始皇遗迹与血脉觉醒",
        "core_setting": "秦始皇留下的遗迹开始显现，丧尸病毒的真相逐渐浮出水面。林渊的血脉被激活，获得更强大的力量，但同时引来境外势力的觊觎",
        "chapter_range": [
          201,
          300
        ],
        "ending_direction": "林渊在遗迹中获得始皇传承，得知丧尸病毒是始皇突破失败的产物，但病毒爆发背后还有更大的阴谋"
      },
      {
        "id": "P5",
        "goal": "抵御境外势力入侵，保护华夏幸存者，同时继续探索始皇延缓敌人入侵的真相",
        "name": "境外势力入侵",
        "core_setting": "境外异能者势力入侵华夏，他们似乎对丧尸病毒和始皇遗迹了如指掌。林渊必须联合各方势力抵御外敌",
        "chapter_range": [
          301,
          400
        ],
        "ending_direction": "林渊击退境外势力第一波进攻，但发现敌人实力远超预期，始皇延缓入侵的手段即将失效"
      },
      {
        "id": "P6",
        "goal": "彻底解决丧尸危机，抵御境外势力全面入侵，开创人类新纪元",
        "name": "终极决战与新纪元",
        "core_setting": "林渊完全觉醒始皇血脉，获得准帝境实力。他必须在境外势力全面入侵前，找到彻底解决丧尸病毒的方法，并带领华夏幸存者走向新生",
        "chapter_range": [
          401,
          500
        ],
        "ending_direction": "林渊继承始皇遗志，彻底净化丧尸病毒，击退境外势力，带领华夏幸存者重建文明"
      }
    ],
    "core_characters": [
      {
        "name": "林渊",
        "brief": "在校大学生，秦始皇血脉觉醒者，被丧尸咬伤后觉醒吸收异能的特殊体质",
        "role_type": "男主"
      },
      {
        "name": "苏晚晴",
        "brief": "林渊的青梅竹马，年上姐姐型角色，在末日中始终陪伴林渊，是他最重要的精神支柱",
        "role_type": "女主"
      },
      {
        "name": "秦始皇",
        "brief": "远古帝王，因突破失败留下丧尸病毒，通过某种手段延缓境外敌人入侵，其布局贯穿整个故事",
        "role_type": "背景人物"
      },
      {
        "name": "李将军",
        "brief": "军方代表，在末日初期组织幸存者，后期成为林渊的重要盟友",
        "role_type": "盟友"
      },
      {
        "name": "神秘境外势力首领",
        "brief": "境外异能者势力领袖，觊觎华夏始皇遗迹和丧尸病毒的秘密",
        "role_type": "反派"
      }
    ]
  },
  "characters": [
    {
      "age": "",
      "name": "林渊",
      "gender": "",
      "skills": "【异能吸收】核心能力，可通过接触吸收丧尸或其他异能者的能力为己用，但有上限且需时间消化。初期只能吸收低级丧尸的强化体质、敏锐嗅觉等基础能力，后期逐渐能吸收更强大的异能。【血脉觉醒】随着对始皇血脉的掌控加深，逐渐解锁帝王威压、元素操控等传承能力。【战斗本能】在生死搏杀中磨练出的直觉反应，配合异能使用威力倍增。",
      "role_type": "男主",
      "appearance": "身高一米八二，体型偏瘦但线条结实，属于典型的穿衣显瘦脱衣有肉。面容清秀，眉眼间透着一股书卷气，但眼神深处藏着不易察觉的锐利。黑发略长，末日后常随意扎起。被丧尸咬伤后，右臂留下一道狰狞的黑色疤痕，偶尔会泛起暗红色的纹路，这是他血脉异能的外在体现。",
      "background": "普通家庭出身的在校大学生，主修历史专业，成绩中上。父母在病毒爆发初期失联，生死未卜。自幼与苏晚晴相识，视其为最重要的亲人。直到被丧尸咬伤后血脉觉醒，才逐渐发现自己竟是秦始皇后裔，体内流淌着远古帝王的血脉。",
      "personality": "外表温和内敛，实则骨子里有股不服输的韧劲。重情重义，对认定的人会拼尽全力保护。初期有些优柔寡断，经历末日洗礼后逐渐变得果决坚毅。有强烈的责任感，即使自身难保也想守护身边的人。内心深处对自身血脉的真相既恐惧又好奇。",
      "current_goal": "保护苏晚晴和幸存者同伴，在末日中活下去；探寻自身血脉的真相和丧尸病毒的起源；找到失联的父母。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "苏晚晴",
      "gender": "",
      "skills": "【基础医疗】掌握急救、包扎、简易手术等医疗技能，是团队的移动医疗站。【心理疏导】善于观察他人情绪，常在林渊迷茫时给予开导和支持。【生存技能】野外生存、物资管理、烹饪等实用技能，末日生活的全能管家。【战斗辅助】后期学会使用弓弩和近战武器，虽不擅长正面战斗但能有效辅助林渊。",
      "role_type": "女主",
      "appearance": "身高一米六八，身材匀称，长发常束成干练的马尾。面容温婉大气，眉眼柔和却透着坚定。皮肤白皙，末日后虽略显憔悴但气质依旧出众。穿着实用的户外服装，腰间常挂着一把改装过的工兵铲。举手投足间有种让人安心的沉稳感。",
      "background": "与林渊从小一起长大，两家是邻居。大学就读于隔壁城市的医学院，病毒爆发时正巧回老家探亲，辗转找到林渊。父母均为医生，从小耳濡目染懂得基础医疗知识。末日中凭借医术成为团队不可或缺的后勤保障，是林渊最信任的人。",
      "personality": "温柔体贴但内心坚韧如钢，是典型的外柔内刚型。比林渊年长三岁，习惯性地照顾他，像姐姐一样包容他的小脾气。做事有条理，危机中能保持冷静分析。对感情含蓄内敛，将对林渊的在意深藏心底，始终以守护者的姿态陪伴左右。",
      "current_goal": "守护林渊，确保他的安全和成长；用医术救助更多幸存者；在末日中与林渊一起找到活下去的意义。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "秦始皇",
      "gender": "",
      "skills": "【帝王之气】即便只是残魂也拥有震慑万物的威压。【布局千年】跨越时空的谋划能力，每一步都环环相扣。【血脉传承】通过遗迹试炼将自身力量和记忆传承给后裔。【病毒掌控】对丧尸病毒有本质上的理解和控制能力。",
      "role_type": "背景人物",
      "appearance": "以虚影或意识残留的形式出现时，身形高大威武，身着玄色龙袍，头戴十二旒冕冠。面容刚毅威严，眼神深邃如渊，仿佛能洞穿千年时光。周身萦绕着淡淡的帝王紫气，即便只是残影也散发着令人窒息的压迫感。",
      "background": "千古一帝，统一六国后追求长生不死，在末法时代尝试突破帝境却失败，意外催生出丧尸病毒。为延缓境外异能者势力入侵华夏，以自身为代价布下千年大局，将病毒作为屏障。通过始皇遗迹留下传承，等待血脉后裔觉醒来完成他未竟的使命。",
      "personality": "雄才大略，心机深沉，为达目的不择手段但又有底线。对华夏子民有深沉的守护之意，但方式冷酷决绝。自信甚至自负，相信自己的布局能跨越千年。对血脉后裔既严厉又期待，视其为传承者而非单纯的后代。",
      "current_goal": "等待血脉后裔完成传承，净化丧尸病毒，守护华夏不被外敌入侵。",
      "first_chapter": 1,
      "current_status": "已故（意识残留）"
    },
    {
      "age": "",
      "name": "李将军",
      "gender": "",
      "skills": "【军事指挥】精通战术战略，能有效组织大规模作战和防御。【武器专家】熟悉各类枪械和军事装备的使用与维护。【领导力】天生的领袖气质，能在混乱中凝聚人心。【格斗术】精通军体拳和近身格斗，即便年长也战斗力不俗。",
      "role_type": "盟友",
      "appearance": "年近五十，身材魁梧挺拔，军姿标准。面容方正，眉宇间有常年征战留下的风霜痕迹。短发花白但精神矍铄，眼神锐利如鹰。常穿迷彩作战服，腰间配着手枪和军刀，举手投足间透着军人特有的干练和威严。",
      "background": "华夏某军区少将，病毒爆发时正率部执行任务。在混乱中收拢残兵和幸存者，建立临时军事据点。凭借卓越的军事素养和领导能力，在末日初期成为少数能有效组织抵抗的力量之一。后与林渊相遇，成为其最重要的盟友。",
      "personality": "刚正不阿，雷厉风行，有强烈的军人荣誉感和责任感。对下属严格但关爱，对敌人冷酷无情。初期对林渊的异能持怀疑态度，认可后则全力支持。重视纪律和秩序，在末日中努力维持人类社会的基本规则。",
      "current_goal": "保护幸存者，重建人类秩序；配合林渊对抗丧尸和境外势力；找到军方高层，恢复国家机器运转。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "神秘境外势力首领",
      "gender": "",
      "skills": "【异能融合】掌握多种异能，且能将其融合使用，威力远超单一异能者。【精神操控】拥有强大的精神系异能，能控制他人或制造幻境。【战略布局】善于利用各方势力的矛盾，坐收渔翁之利。【近战大师】即便不用异能，纯肉搏能力也极其恐怖。",
      "role_type": "反派",
      "appearance": "身形高大，约一米九，体格健硕。常戴银色面具遮住上半张脸，只露出薄唇和棱角分明的下巴。金色短发向后梳得一丝不苟，碧绿色眼眸在面具后闪烁着冷酷的光芒。穿着黑色战术风衣，气质优雅却透着危险。",
      "background": "境外某异能者组织的首领，该组织世代觊觎华夏大地的灵气和秘密。得知秦始皇突破失败留下丧尸病毒和遗迹后，策划多年终于等到病毒爆发的时机。自身实力深不可测，手下聚集了大量异能者，是末日中最大的外部威胁。",
      "personality": "极度自负且野心勃勃，视华夏为待宰的猎物。冷酷无情，为达目的可以牺牲任何人，包括自己的手下。有强烈的控制欲和占有欲，对始皇遗迹和丧尸病毒的秘密志在必得。表面绅士有礼，实则残忍嗜血。",
      "current_goal": "夺取始皇遗迹中的传承和丧尸病毒的核心秘密；征服华夏，建立以异能者为主导的新秩序。",
      "first_chapter": 1,
      "current_status": "存活"
    }
  ],
  "foreshadowing": [],
  "character_links": []
}
