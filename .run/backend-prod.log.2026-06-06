  "story": {
    "genre": "末日异能",
    "title": "丧尸纪元：始皇血脉",
    "volume": "第一卷：末日降临"
  },
  "outline": {
    "story": {
      "genre": "末日异能",
      "title": "丧尸纪元：始皇血脉",
      "volume": "第一卷：末日降临"
    },
    "ending": {
      "direction": "男主林渊成功激活始皇血脉，继承其对抗入侵的遗志，找到将丧尸病毒转化为人类进化力量的方法，建立人类与进化丧尸共存的新秩序，开启人类文明新纪元"
    },
    "macro_phases": [
      {
        "id": "P1",
        "goal": "男主林渊在丧尸爆发初期被咬感染，意外觉醒异能，与青梅竹马苏晚晴汇合，组建生存小队，建立初期避难所",
        "name": "末日降临与觉醒",
        "core_setting": "现代都市末日背景，丧尸病毒突然爆发，城市沦陷。男主被咬后未变成丧尸，反而获得感知丧尸、与丧尸微弱共感的能力，但需要不断压制体内病毒",
        "chapter_range": [
          1,
          80
        ],
        "ending_direction": "男主异能初步觉醒，发现自己的血液对丧尸有特殊影响，引起神秘组织注意"
      },
      {
        "id": "P2",
        "goal": "在废墟城市中生存壮大，与其他幸存者势力接触冲突，揭开丧尸进化的秘密，男主异能逐步开发",
        "name": "城市求生与势力初现",
        "core_setting": "丧尸开始出现进化体，普通丧尸之上有变异丧尸、精英丧尸等层级。各方势力割据，军方、民间组织、神秘势力并存",
        "chapter_range": [
          81,
          180
        ],
        "ending_direction": "男主发现丧尸病毒中蕴含着某种远古力量，与自己的血脉产生共鸣"
      },
      {
        "id": "P3",
        "goal": "离开城市前往其他区域探索，寻找病毒起源线索，男主血脉秘密开始浮现，遭遇更强敌人",
        "name": "远征与真相初现",
        "core_setting": "世界格局逐渐清晰，不同区域有不同的丧尸生态和势力分布。开始出现与秦朝相关的远古遗迹和线索",
        "chapter_range": [
          181,
          300
        ],
        "ending_direction": "男主进入秦始皇陵外围区域，触发血脉共鸣，获得部分记忆碎片，世界观开始揭露"
      },
      {
        "id": "P4",
        "goal": "深入探索秦始皇与丧尸病毒的关系，揭露病毒起源真相，同时应对外星/异界入侵者的先遣部队",
        "name": "始皇之谜与境外威胁",
        "core_setting": "秦始皇为对抗未来入侵而布局的真相逐步揭开，丧尸病毒是其突破失败的产物，但也是延缓入侵的手段。境外敌人开始渗透",
        "chapter_range": [
          301,
          420
        ],
        "ending_direction": "男主确认自己是秦始皇后裔，体内血脉是解开一切谜团的关键"
      },
      {
        "id": "P5",
        "goal": "男主继承始皇遗志，联合各方势力对抗境外入侵，同时寻找彻底解决丧尸病毒的方法，开启人类新纪元",
        "name": "终局之战与新纪元",
        "core_setting": "境外敌人全面入侵，丧尸病毒反而成为人类对抗入侵的力量来源。男主需要在拯救人类和彻底消灭丧尸之间做出抉择",
        "chapter_range": [
          421,
          550
        ],
        "ending_direction": "男主成功抵御入侵，找到平衡点，人类进入与丧尸共存的新时代"
      }
    ],
    "core_characters": [
      {
        "name": "林渊",
        "brief": "在校大学生，被丧尸咬伤后觉醒异能，拥有秦始皇血脉，是解开末日谜团的关键",
        "role_type": "男主"
      },
      {
        "name": "苏晚晴",
        "brief": "男主青梅竹马，年上姐姐，不同校的大学生，末日中陪伴男主成长，拥有特殊治愈能力",
        "role_type": "女主"
      },
      {
        "name": "赵铁山",
        "brief": "退役特种兵，末日后成为生存专家，教导男主战斗技巧和生存智慧",
        "role_type": "导师"
      },
      {
        "name": "秦无月",
        "brief": "自称秦始皇后裔的神秘强者，试图利用丧尸病毒实现自己的野心，与男主血脉相冲",
        "role_type": "反派"
      },
      {
        "name": "白小楼",
        "brief": "天才科学家，研究丧尸病毒的专家，为男主提供关键技术支持和情报",
        "role_type": "配角"
      },
      {
        "name": "李青衣",
        "brief": "军方女军官，末日后建立安全区，与男主亦敌亦友，代表官方势力",
        "role_type": "配角"
      }
    ]
  },
  "characters": [
    {
      "age": "",
      "name": "林渊",
      "gender": "",
      "skills": "丧尸感知：能感知半径百米内丧尸的位置和数量，觉醒后范围逐渐扩大。血液驱散：自身血液对丧尸有短暂驱散效果，后期可控制丧尸行动。血脉共鸣：触发时可获得远古记忆碎片，解锁始皇留下的力量。战斗本能：血脉觉醒后战斗直觉大幅提升，能预判敌人动作。",
      "role_type": "男主",
      "appearance": "身高一米八二，体型偏瘦但肌肉线条流畅。黑色短发略显凌乱，左眉尾有一道浅浅的疤痕。眼睛是深褐色，觉醒异能后偶尔会闪过一丝金色光芒。面容清秀，带着几分书卷气，末日后眼神变得更加坚毅。常穿深色冲锋衣，左手腕戴着一块旧式机械表。",
      "background": "普通大学生，父母在末日初期失联。从小由爷爷抚养长大，爷爷临终前留下一块刻有奇怪纹路的玉佩。末日爆发当天被丧尸咬伤，本应变异却意外觉醒异能。后来发现玉佩上的纹路与秦朝文物中的龙纹高度吻合，暗示其秦始皇后裔的身份。",
      "personality": "表面温和内敛，实则内心坚韧。末日前是个有些社恐的宅男，喜欢历史和古籍。面对危机时展现出超乎寻常的冷静和果断，但内心深处对失去亲人朋友有着强烈的恐惧。重情重义，愿意为保护他人牺牲自己。随着血脉觉醒，逐渐展现出领袖气质，但始终保持谦逊。",
      "current_goal": "在末日中生存下去，同时寻找自己血脉觉醒的真相，保护身边重要的人",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "苏晚晴",
      "gender": "",
      "skills": "生命治愈：能加速伤口愈合，缓解中毒和感染症状。后期可净化丧尸病毒，但会消耗大量体力。医疗知识：系统的医学背景，擅长战场急救和疾病防治。心灵感应：与林渊之间存在微弱的心灵感应，能感知对方的情绪状态。领导才能：善于协调团队关系，是避难所内部事务的主要管理者。",
      "role_type": "女主",
      "appearance": "身高一米六八，身材匀称，长发常扎成利落的马尾。鹅蛋脸，五官温婉秀气，眼睛是清澈的琥珀色。皮肤白皙，末日后因长期户外活动略显小麦色。常穿便于行动的运动装，脖子上戴着一条银色项链，吊坠是小时候林渊送的四叶草。",
      "background": "比林渊大两岁的青梅竹马，从小一起长大。大学就读于隔壁城市的医学院，主修护理专业。末日爆发时正在医院实习，凭借专业知识在初期救下不少人。与林渊重逢后，始终陪伴在他身边，见证他从普通大学生到末日领袖的蜕变。两人虽亲密无间，却始终保持着微妙的非情侣关系。",
      "personality": "温柔体贴，善解人意，有着超越年龄的成熟和稳重。作为年上姐姐，对林渊有着强烈的保护欲，但尊重他的成长和选择。内心坚强，面对末日的残酷从不轻易崩溃。有些小洁癖，喜欢把避难所收拾得井井有条。偶尔会露出俏皮的一面，是团队中的精神支柱。",
      "current_goal": "保护林渊不被血脉力量反噬，同时寻找治愈丧尸病毒的方法",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "赵铁山",
      "gender": "",
      "skills": "格斗大师：精通多种格斗术，擅长近身搏击和冷兵器作战。战术指挥：具备丰富的战场指挥经验，能制定高效的作战计划。野外生存：精通各种野外生存技巧，能在恶劣环境下维持队伍运转。武器专家：熟悉各类枪械和冷兵器的使用与维护。危机处理：面对突发状况能保持冷静，迅速做出正确判断。",
      "role_type": "导师",
      "appearance": "身高一米八五，体型魁梧健硕，肌肉虬结。国字脸，浓眉大眼，下巴有一道明显的刀疤。平头短发，两鬓微白，眼神锐利如鹰。常穿迷彩作战服，腰间别着一把军用匕首。右手食指缺失半截，据说是多年前执行任务时留下的。",
      "background": "退役特种兵，曾服役于某王牌部队，执行过多次高危任务。退役后在安保公司工作，末日爆发时正在执行押运任务。凭借过硬的军事素养在初期幸存，组建了一支小型生存队伍。在一次遭遇战中被林渊的异能吸引，决定重点培养这个年轻人。将林渊视为自己的接班人，倾囊相授战斗技巧和生存智慧。",
      "personality": "沉稳老练，行事果断，有着军人特有的纪律性和责任感。表面严肃不苟言笑，实则内心柔软，对晚辈关爱有加。信奉实力至上的生存法则，但坚守底线，绝不伤害无辜。偶尔会讲冷笑话，在团队士气低落时用幽默调节气氛。对林渊寄予厚望，严格要求的同时也给予充分信任。",
      "current_goal": "将林渊培养成合格的领袖，带领人类在末日中生存下去",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "秦无月",
      "gender": "",
      "skills": "病毒操控：能操控丧尸病毒，加速丧尸进化或控制其行动。血脉压制：对低等级始皇后裔有血脉压制效果，可削弱其异能。古武秘术：掌握失传的秦朝古武，战斗方式诡异莫测。精神攻击：能通过眼神或声音对敌人进行精神干扰。战略布局：擅长长线布局，能预判局势发展并提前设局。",
      "role_type": "反派",
      "appearance": "身高一米八零，体型修长，举止优雅从容。面容俊美得近乎妖异，皮肤苍白如纸，眼睛是罕见的紫色。长发披肩，常穿黑色长袍，腰间系着一条绣有龙纹的腰带。手指修长，指甲修剪得一丝不苟。身上常带着一股淡淡的檀香气息，举手投足间透着贵族气质。",
      "background": "自称秦始皇后裔，掌握着部分失传的秦朝秘术。真实身份成谜，有人说他是从古墓中醒来的活尸，也有人说他是获得了始皇传承的现代人。末日前就已存在，一直在暗中收集与始皇有关的文物和情报。认为丧尸病毒是始皇留下的考验，只有通过考验的人才有资格继承始皇的遗产。",
      "personality": "外表温文尔雅，实则内心冷酷无情。将所有人视为棋子，为达目的不择手段。对始皇有着近乎偏执的崇拜，认为自己才是始皇真正的继承者。与林渊血脉相冲，视其为最大的威胁和障碍。有着极强的控制欲，不允许任何事情脱离掌控。偶尔会流露出对永恒生命的厌倦，但很快被野心掩盖。",
      "current_goal": "夺取林渊的血脉力量，完成始皇未竟的事业，建立新的秩序",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "白小楼",
      "gender": "",
      "skills": "病毒研究：对丧尸病毒有着深入研究，能分析病毒变异规律。基因编辑：掌握先进的基因编辑技术，试图开发病毒抑制剂。情报分析：善于从零散信息中拼凑出完整情报，为团队提供决策支持。机械改造：擅长改装各种设备，为避难所提供技术支持。数据分析：能快速处理大量数据，预测丧尸潮动向。",
      "role_type": "配角",
      "appearance": "身高一米七五，体型偏瘦，戴着一副银色细框眼镜。面容清秀，皮肤因长期待在实验室而略显苍白。棕色短发有些凌乱，经常忘记打理。眼睛是浅褐色，思考时会不自觉地眯起。常穿白色实验服，口袋里塞满了各种小工具和笔记。左手无名指戴着一枚旧戒指，据说是已故导师的遗物。",
      "background": "天才病毒学家，曾是国家级实验室最年轻的研究员。末日前就在研究一种神秘病毒样本，该样本与丧尸病毒高度相似。末日爆发后，意识到自己的研究可能与病毒起源有关，开始四处寻找线索。在一次外出采集样本时被林渊的血液样本吸引，主动加入团队。为林渊提供关键技术支持，帮助他理解自己的血脉力量。",
      "personality": "典型的科研狂人，对未知事物有着近乎偏执的好奇心。情商较低，说话直来直去，经常无意中得罪人。但内心善良，只是不擅长表达。对林渊的血脉力量极度着迷，经常提出各种实验请求。在关键时刻能保持冷静，用科学方法解决问题。对已故导师怀有深厚感情，继承了其未竟的研究事业。",
      "current_goal": "破解丧尸病毒的秘密，开发出有效的疫苗或抑制剂",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "",
      "name": "李青衣",
      "gender": "",
      "skills": "军事指挥：具备丰富的军事指挥经验，能高效组织防御和作战。武器专家：精通各类枪械和战术装备的使用。情报收集：拥有军方情报网络，能获取多方势力动向。政治手腕：善于在不同势力之间周旋，维护安全区利益。危机管理：能快速处理各种突发事件，维持安全区秩序。",
      "role_type": "配角",
      "appearance": "身高一米七零，身材挺拔，英姿飒爽。短发齐耳，五官英气，眼神锐利而坚定。皮肤是健康的小麦色，脸上有一道从左眼角延伸到颧骨的疤痕。常穿军用作战服，腰间配着手枪和战术匕首。站姿笔挺，行走时步伐稳健有力，浑身散发着军人的威严。",
      "background": "军方少校军官，末日前负责某军事基地的安保工作。末日爆发后，迅速组织幸存者建立安全区，成为军方在末日中的代表。对林渊的异能既感兴趣又充满警惕，认为异能者可能成为新的威胁。在多次接触后，逐渐认可林渊的品格和能力，但始终保持着适当的距离。代表官方势力与林渊合作，共同应对末日危机。",
      "personality": "刚正不阿，纪律严明，有着强烈的使命感和责任感。对上级命令绝对服从，但也会在必要时据理力争。表面冷硬，实则内心有着柔软的一面，对下属关怀备至。不信任任何来历不明的异能者，对林渊始终保持警惕。随着接触加深，逐渐认可林渊的能力和品格，但仍坚持原则。在个人情感和军人职责之间挣扎，最终选择后者。",
      "current_goal": "维护安全区秩序，寻找与林渊合作的最佳方式，为人类争取更多生存空间",
      "first_chapter": 1,
      "current_status": "存活"
    }
  ],
  "foreshadowing": [],
