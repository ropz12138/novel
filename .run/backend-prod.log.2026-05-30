2026-05-30 18:22:16 INFO app.services.supervisor.supervisor_agent supervisor.tool_result tool=read_outline content_preview=标题：帝脉觉醒：丧尸末日中的秦始皇遗产
类型：丧尸末日/玄幻异能
卷：第一卷：校园生存期
时间线节点数：10
伏笔数：12

完整大纲：
{
  "story": {
    "genre": "丧尸末日/玄幻异能",
    "title": "帝脉觉醒：丧尸末日中的秦始皇遗产",
    "volume": "第一卷：校园生存期"
  },
  "branches": [
    {
      "id": "B1",
      "name": "室友羁绊线",
      "side": "right",
      "summary": "以林轩、张伟、李默三人为核心，展现末日爆发初期宿舍楼内的生存困境。张伟的乐观与李默的冷静形成互补，三人从最初的恐慌到逐渐建立信任，共同面对食物短缺、丧尸围困等危机。这条支线深入刻画兄弟情谊，为后续团队核心奠定基础。",
      "attach_to": "T1",
      "chapter_end": 15,
      "chapter_start": 1
    },
    {
      "id": "B2",
      "name": "苏晴寻亲线",
      "side": "left",
      "summary": "末日爆发时苏晴在另一所大学，她凭借武术功底和冷静判断，一路穿越丧尸横行的城区，只为找到林轩。途中遭遇各种幸存者团队，见识人性善恶。她的到来不仅是情感支撑，更是林轩觉醒的关键催化剂，体现青梅竹马的深厚羁绊。",
      "attach_to": "T2",
      "chapter_end": 25,
      "chapter_start": 16
    },
    {
      "id": "B3",
      "name": "校园势力博弈线",
      "side": "right",
      "summary": "王琳在图书馆建立据点，与林轩的宿舍区势力形成对峙。双方在资源分配、人员管理、对外策略上产生分歧。王琳对林轩的异能既警惕又渴望利用，而林轩则在保护与扩张之间艰难抉择。这条支线展现末日中权力斗争与人性考验。",
      "attach_to": "T3",
      "chapter_end": 45,
      "chapter_start": 26
    },
    {
      "id": "B4",
      "name": "陈雪研究线",
      "side": "left",
      "summary": "陈雪利用医学知识研究丧尸病毒，发现林轩的血液样本存在异常。她秘密进行实验，试图破解免疫机制，同时记录丧尸变异规律。这条支线为后续世界观真相埋下伏笔，也展现科学在末日中的价值与局限。",
      "attach_to": "T3",
      "chapter_end": 45,
      "chapter_start": 26
    },
    {
      "id": "B5",
      "name": "军方铁腕线",
      "side": "right",
      "summary": "赵铁柱的部队在校园外围建立封锁线，以军事化手段控制幸存者。他派人搜索校园，试图抓捕异能者进行研究。林轩团队在突围时与军方发生冲突，首次见识到末日中人类内部的残酷斗争，也意识到外界秩序已彻底崩坏。",
      "attach_to": "T4",
      "chapter_end": 60,
      "chapter_start": 46
    },
    {
      "id": "B6",
      "name": "始皇符文解密线",
      "side": "left",
      "summary": "李默在破解青铜器符文时展现出惊人天赋，他发现符文与古代阵法、星象有关。随着研究深入，符文指向始皇陵与帝境突破的记载。这条支线逐步揭开世界观真相，也让李默从技术宅成长为解密关键人物。",
      "attach_to": "T5",
      "chapter_end": 75,
      "chapter_start": 61
    },
    {
      "id": "B7",
      "name": "尸王猎杀线",
      "side": "right",
      "summary": "尸王在城市废墟中建立巢穴，指挥尸潮扩张领地。赵铁柱派出精锐部队试图捕获尸王，却遭遇惨败。林轩的帝威能力对尸王产生特殊压制，引起尸王的仇恨与恐惧。这条支线展现丧尸进化的恐怖，也为最终决战埋下伏笔。",
      "attach_to": "T6",
      "chapter_end": 90,
      "chapter_start": 76
    },
    {
      "id": "B8",
      "name": "嬴玄布局线",
      "side": "left",
      "summary": "嬴玄以神秘姿态现身，向林轩揭示部分真相：丧尸病毒源于始皇突破帝境的失败。他邀请林轩加入，但林轩对其目的存疑。嬴玄的出现让林轩开始正视自己的血脉与使命，也让他意识到末日背后隐藏着更大的阴谋。",
      "attach_to": "T7",
      "chapter_end": 105,
      "chapter_start": 91
    },
    {
      "id": "B9",
      "name": "苏晴觉醒线",
      "side": "right",
      "summary": "在林轩帝威完全觉醒的过程中，苏晴的精神支持起到关键作用。她的意志与林轩的血脉产生共鸣，意外觉醒了与帝威互补的能力。这条支线深化两人羁绊，也让苏晴从辅助角色成长为独立战力。",
      "attach_to": "T8",
      "chapter_end": 120,
      "chapter_start": 106
    },
    {
      "id": "B10",
      "name": "天魔入侵线",
      "side": "left",
      "summary": "随着真相揭露，境外天魔的威胁逐渐显现。尸王进化为天魔先锋，开始撕裂空间。林轩意识到始皇布局的真正目的：丧尸病毒是筛选强者的试炼，而他是抵御天魔的关键。这条支线将末日危机提升到宇宙层面。",
      "attach_to": "T9",
      "chapter_end": 140,
      "chapter_start": 121
    },
    {
      "id": "B11",
      "name": "最终联盟线",
      "side": "right",
      "summary": "林轩联合嬴玄、苏晴、王琳、赵铁柱残部等各方力量，在始皇遗迹进行最终决战。各方势力从对立到合作，共同对抗天魔先锋。这条支线展现末日中人类团结的可能性，也为新时代开启奠定基础。",
      "attach_to": "T10",
      "chapter_end": 160,
      "chapter_start": 141
    }
  ],
  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "丧尸病毒突然爆发，男主林轩与室友张伟、李默被困宿舍楼。初期以写实笔触描绘混乱、恐惧与资源争夺，展现末日生存的残酷与人性挣扎。",
      "time_node": "末日第1-7天",
      "chapter_end": 15,
      "chapter_start": 1,
      "development_node": "末日爆发与校园求生"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "男主在保护同学时被丧尸咬伤，陷入感染危机。青梅竹马女主苏晴不顾危险赶来陪伴，成为他意志支撑的关键。男主在濒死中意外觉醒异能，同时获得部分丧尸能力。",
      "time_node": "末日第8-10天",
      "chapter_end": 25,
      "chapter_start": 16,
      "development_node": "感染与觉醒"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "男主初步掌控“帝威”异能与尸毒免疫、丧尸感知等能力。带领小队清理宿舍区，建立临时据点。期间遭遇学生会主席王琳的势力冲突，展现人性博弈。",
      "time_node": "末日第11-30天",
      "chapter_end": 45,
      "chapter_start": 26,
      "development_node": "能力掌控与校园清理"
    },
    {
      "id": "T4",
      "order": 4,
      "summary": "校园资源告罄，男主决定带队突围。途中首次遭遇军方激进派赵铁柱的部队，发现外界秩序已崩坏。同时，男主感应到城市深处存在特殊丧尸信号。",
      "time_node": "末日第31-45天",
      "chapter_end": 60,
      "chapter_start": 46,
      "development_node": "校园突围与外界线索"
    },
    {
      "id": "T5",
      "order": 5,
      "summary": "在探索废弃博物馆时，男主发现刻有古老符文的青铜器，触发血脉共鸣。李默破解部分符文，指向“始皇”与“帝境”。男主开始怀疑自身能力来源。",
      "time_node": "末日第46-60天",
      "chapter_end": 75,
      "chapter_start": 61,
      "development_node": "秦始皇线索初现"
    },
    {
      "id": "T6",
      "order": 6,
      "summary": "进化体“尸王”首次出现，展现恐怖实力。赵铁柱试图捕获尸王作为武器，与男主团队爆发冲突。男主“帝威”能力对尸王产生特殊压制，引起各方关注。",
      "time_node": "末日第61-75天",
      "chapter_end": 90,
      "chapter_start": 76,
      "development_node": "尸王现身与阵营冲突"
    },
    {
      "id": "T7",
      "order": 7,
      "summary": "神秘人物嬴玄现身，自称秦始皇后裔，揭示部分世界观真相：丧尸病毒源于始皇突破帝境失败。嬴玄邀请男主加入，但男主对其目的存疑。",
      "time_node": "末日第76-90天",
      "chapter_end": 105,
      "chapter_start": 91,
      "development_node": "血脉觉醒者嬴玄登场"
    },
    {
      "id": "T8",
      "order": 8,
      "summary": "男主在对抗尸王时陷入危机，苏晴的呼唤激发血脉潜能，“帝威”完全觉醒。同时男主学会主动控制尸化强化，在保持理智下大幅提升身体素质。",
      "time_node": "末日第91-100天",
      "chapter_end": 120,
      "chapter_start": 106,
      "development_node": "帝威完全觉醒与尸化控制"
    },
    {
      "id": "T9",
      "order": 9,
      "summary": "通过嬴玄与古老遗迹，男主得知完整真相：始皇为抵御“境外天魔”入侵，以失败为代价布下千年之局。丧尸病毒是筛选强者的试炼，男主是计划关键执行者。",
      "time_node": "末日第101-120天",
      "chapter_end": 140,
      "chapter_start": 121,
      "development_node": "始皇布局真相揭露"
    },
    {
      "id": "T10",
      "order": 10,
      "summary": "尸王进化为“天魔先锋”，赵铁柱势力崩溃。男主联合嬴玄、苏晴及各方力量，在始皇遗迹进行最终决战。男主以帝威引导丧尸大军对抗天魔，为人类赢得喘息之机。",
      "time_node": "末日第121-150天",
