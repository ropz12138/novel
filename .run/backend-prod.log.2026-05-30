完整大纲：
{
  "story": {
    "genre": "丧尸末日",
    "title": "秦帝丧尸：末日觉醒",
    "volume": "第一卷：末日爆发与生存"
  },
  "branches": [
    {
      "id": "B1",
      "name": "玉佩秘密线",
      "side": "left",
      "summary": "林轩在求生过程中发现祖父留下的玉佩在丧尸靠近时会微微发热，暗示其与秦始皇血脉的关联。玉佩成为后续探索古代秘密的关键道具，初期表现为神秘的保护作用。",
      "attach_to": "T1",
      "chapter_end": 25,
      "chapter_start": 5
    },
    {
      "id": "B2",
      "name": "苏晚身世伏笔线",
      "side": "right",
      "summary": "苏晚在照顾林轩时展现出超乎寻常的冷静与急救知识，暗示其父母的科研背景可能与末日事件有关。她偶尔流露出对某种‘预兆’的熟悉感，为后期真相揭露埋下伏笔。",
      "attach_to": "T1",
      "chapter_end": 28,
      "chapter_start": 8
    },
    {
      "id": "B3",
      "name": "丧尸变异观察线",
      "side": "left",
      "summary": "林轩发现自己的血液能短暂安抚低阶丧尸，但也会吸引特殊变异体。陈默协助记录变异规律，发现丧尸进化似乎遵循某种‘帝王阶位’模式，暗示病毒与古代权力体系的关联。",
      "attach_to": "T2",
      "chapter_end": 55,
      "chapter_start": 35
    },
    {
      "id": "B4",
      "name": "赤狼帮冲突线",
      "side": "right",
      "summary": "赵雪率领的赤狼帮与林轩小队因资源争夺爆发冲突。赵雪觊觎林轩的特殊能力，试图胁迫其加入。苏晚与赵雪的对抗展现女性领导力的碰撞，最终以临时合作告终，但埋下后续分裂隐患。",
      "attach_to": "T2",
      "chapter_end": 58,
      "chapter_start": 40
    },
    {
      "id": "B5",
      "name": "秦代遗迹探索线",
      "side": "left",
      "summary": "周教授加入后，带领林轩探索校园附近的秦代祭祀遗迹。通过破解竹简与机关，逐步揭示秦始皇突破帝境失败、丧尸病毒诞生的真相。林轩的血脉在此过程中进一步觉醒。",
      "attach_to": "T3",
      "chapter_end": 85,
      "chapter_start": 65
    },
    {
      "id": "B6",
      "name": "境外势力渗透线",
      "side": "right",
      "summary": "影首次现身，暗中破坏遗迹防御机关，窃取病毒样本。林轩小队遭遇不明势力的袭击，发现境外组织已渗透国内。影的蓝色眼睛与特殊抗性暗示其与秦始皇时代的‘外敌’有关。",
      "attach_to": "T3",
      "chapter_end": 88,
      "chapter_start": 70
    },
    {
      "id": "B7",
      "name": "人类内部分裂线",
      "side": "left",
      "summary": "丧尸病毒真相泄露后，幸存者团体分裂为‘净化派’（消灭所有感染者）与‘共存派’（利用林轩能力）。赵雪的赤狼帮成为净化派主力，与林轩小队彻底决裂，人类内战一触即发。",
      "attach_to": "T4",
      "chapter_end": 115,
      "chapter_start": 95
    },
    {
      "id": "B8",
      "name": "最终使命抉择线",
      "side": "right",
      "summary": "林轩面临终极抉择：激活秦始皇留下的‘帝王阵’可彻底净化病毒，但需牺牲自身血脉；或融合丧尸能力成为新帝，但可能丧失人性。苏晚的支持成为他坚持信念的关键，两人关系在末日中升华为超越爱情的羁绊。",
      "attach_to": "T4",
      "chapter_end": 118,
      "chapter_start": 100
    }
  ],
  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "丧尸病毒在校园爆发，男主林轩被咬伤感染，在青梅竹马苏晚的陪伴下经历生死危机。林轩在濒死时意外觉醒异能，同时获得部分丧尸能力（如超强愈合、夜视），成为特殊存在。两人在混乱中寻找安全据点，初步建立生存小队。",
      "time_node": "末日第1-7天",
      "chapter_end": 30,
      "chapter_start": 1,
      "development_node": "末日爆发与初始求生"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "林轩开始探索并适应双重能力，发现自己的血液对丧尸有特殊影响（可短暂安抚或吸引）。苏晚协助他控制能力，两人关系在生死考验中逐渐深化。小队遭遇其他幸存者团体，冲突与合作并存，同时发现丧尸变异现象加剧。",
      "time_node": "末日第8-30天",
      "chapter_end": 60,
      "chapter_start": 31,
      "development_node": "能力探索与适应"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "林轩在探索中发现秦始皇相关遗迹，逐步揭露丧尸病毒源于秦始皇突破帝境失败的产物。他的血脉觉醒与秦始皇谋划有关，病毒爆发是抵御境外入侵的代价。苏晚得知真相后，两人共同面对历史重负。",
      "time_node": "末日第31-60天",
      "chapter_end": 90,
      "chapter_start": 61,
      "development_node": "真相揭露与古代秘密"
    },
    {
      "id": "T4",
      "order": 4,
      "summary": "境外威胁显现，丧尸病毒真相引发人类内部分裂。林轩必须在拯救人类与完成秦始皇使命间抉择，苏晚成为他最坚定的支持者。最终决战中，林轩融合血脉与丧尸能力，试图终结末日危机，但代价未知。",
      "time_node": "末日第61-90天",
      "chapter_end": 120,
      "chapter_start": 91,
      "development_node": "对抗与最终抉择"
    }
  ],
  "characters": [
    {
      "age": "20",
      "name": "林轩",
      "gender": "男",
      "skills": "觉醒前无特殊能力；觉醒后获得异能「帝王威压」（可短暂震慑丧尸）与丧尸能力（超强愈合、夜视、对丧尸病毒免疫），血液对丧尸有特殊影响。",
      "role_type": "主角",
      "appearance": "身高178cm，体型偏瘦但结实，短发，眉眼间透着一股倔强与温和。平时穿着休闲，常戴一副黑框眼镜，被咬伤后左臂留下特殊疤痕，觉醒异能后瞳孔在暗处会泛起淡淡金色。",
      "background": "普通大学生，父母早逝，由祖父抚养长大，祖父临终前留下一枚古朴玉佩，暗示家族与古代帝王有关。与苏晚从小一起长大，对她有着超越友情的依赖。",
      "personality": "外表温和内敛，内心坚韧执着，重情重义，对青梅竹马苏晚有着复杂的依赖与情感。面对危机时冷静果断，但偶尔会因血脉觉醒的冲动而陷入矛盾。",
      "current_goal": "在末日中保护苏晚，寻找安全的生存据点，并探索自己血脉觉醒的秘密。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "22",
      "name": "苏晚",
      "gender": "女",
      "skills": "精通近身格斗、战术规划与急救处理，擅长使用冷兵器，观察力敏锐，能在混乱中快速制定生存策略。",
      "role_type": "主角",
      "appearance": "身高168cm，身材高挑匀称，长发常束成马尾，面容清冷，眼神锐利但偶尔流露出温柔。穿着干练，偏好运动装，随身携带一把改装过的战术匕首。",
      "background": "比林轩大两岁的大学生，父母是科研人员，常年在外，因此从小与林轩一家亲近。擅长格斗与急救，曾参加过野外生存训练，对末日爆发有超乎常人的适应力。",
      "personality": "外冷内热，表面理性冷静，对陌生人保持距离，但对林轩有着深厚的保护欲与责任感。年上姐姐的成熟与细腻，在危机中展现出强大的领导力与决断力。",
      "current_goal": "保护林轩度过感染危机，协助他控制异能，并在末日中建立稳定的生存秩序。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "21",
      "name": "陈默",
      "gender": "男",
      "skills": "精通战术规划、资源管理与野外生存，擅长使用枪械与冷兵器，能快速搭建临时防御工事。",
      "role_type": "配角",
      "appearance": "身高182cm，体型健壮，短寸头，面容沉稳，眼神专注。常穿迷彩服或工装，随身携带战术背包与多功能工具，手臂上有旧伤疤痕。",
      "background": "林轩的大学室友，军事爱好者，曾参加过军事社团训练。家中经营户外用品店，对生存装备与资源管理有丰富知识。末日爆发时正在校外实习，第一时间赶回校园寻找林轩。",
      "personality": "沉稳可靠，逻辑性强，擅长分析与规划，是团队中的定海神针。话不多但句句关键，对朋友忠诚，危机中能保持冷静判断。",
      "current_goal": "协助林轩与苏晚建立生存小队，确保团队资源供应与安全，并在末日中寻找更多幸存者。",
      "first_chapter": 10,
      "current_status": "存活"
    },
    {
      "age": "19",
      "name": "赵雪",
      "gender": "女",
      "skills": "极强的野外生存知识与格斗技巧，擅长制定防御策略和资源搜寻计划，拥有不俗的近战战斗力。",
      "role_type": "配角",
      "appearance": "身材高挑，留着利落的黑色短发，眼神锐利如鹰。常穿着改装过的工装裤和黑色背心，腰间别着一把消防斧，手臂上有明显的抓痕伤疤。",
      "background": "体育学院大一新生，末日前曾是校女子防身术社团成员。末日爆发时正独自在校外，凭借过人的体能和狠劲拉起了一支名为“赤狼帮”的幸存者队伍，以严厉的纪律维持团体运转。",
      "personality": "外冷内热，极具领导魅力与决断力。为了生存可以不择手段，初期表现出强烈的领地意识和攻击性，但内心深处存有底线和对弱者的保护欲。",
      "current_goal": "确保“赤狼帮”在末日中生存下去，并寻找机会扩张势力范围，对林轩小队的资源抱有觊觎之心。",
      "first_chapter": 15,
      "current_status": "存活"
    },
    {
      "age": "未知",
      "name": "秦始皇",
      "gender": "男",
      "skills": "掌握上古秘术与帝王权谋，能通过血脉烙印传递信息，布局千年，对丧尸病毒有部分控制权。",
      "role_type": "配角",
      "appearance": "以全息影像或精神烙印形式出现时，呈现为身着玄色龙袍、头戴冕旒的威严帝王形象，面容冷峻，眼神深邃如渊，周身环绕着若有若无的金色气运。",
      "background": "千古一帝，在末法时代试图突破帝境失败，丧尸病毒是其失败产物。通过特殊手段延缓境外敌人入侵，将希望寄托于血脉后人。其谋划贯穿两千年，丧尸病毒爆发是计划的一部分。",
      "personality": "雄才大略，意志坚定，为达目的不惜代价，但内心深处有着对华夏文明的守护执念。算无遗策，善于布局千年，对血脉后人既期待又警惕。",
      "current_goal": "通过血脉后人林轩完成未竟的使命，抵御境外入侵，守护华夏文明。",
      "first_chapter": 61,
      "current_status": "已故（但精神烙印留存）"
    },
    {
      "age": "55",
      "name": "周教授",
      "gender": "男",
      "skills": "深厚的历史学与考古学知识，对秦代典籍、密码、机关有深入研究，具备极强的逻辑推理与信息分析能力。",
      "role_type": "配角",
      "appearance": "头发花白，戴着一副金丝边眼镜，面容清瘦但精神矍铄。常穿着洗得发白的衬衫和旧西装外套，即便在末日也保持着学者的整洁。",
      "background": "国内顶尖大学的历史系教授，专攻秦汉史。末日爆发时正在校内整理一批新出土的秦代竹简，这些竹简成为他后来研究的关键。",
      "personality": "儒雅沉稳，学识渊博但不迂腐。在末日中保持着学者的冷静与好奇心，对真相有着近乎偏执的追求，但为人温和，愿意分享知识。",
      "current_goal": "在末日中保护并整理秦始皇相关的历史资料，寻找能解释末日真相的线索，试图理解这场灾难的历史根源。",
      "first_chapter": 65,
      "current_status": "存活"
    },
    {
      "age": "30",
      "name": "影",
      "gender": "男",
      "skills": "顶尖的潜行、暗杀与情报收集能力，精通现代武器与古代机关破解，对丧尸病毒有部分抗性，能有限度地指挥低阶丧尸。",
      "role_type": "反派",
      "appearance": "身形瘦削，常披着一件带有兜帽的灰色斗篷，面容隐藏在阴影中，只露出一双冰冷的蓝色眼睛。行动时悄无声息，如同真正的影子。",
      "background": "身份成谜，疑似来自境外某个神秘组织。精通多国语言与格斗术，对秦始皇的谋划和丧尸病毒的真相有超出常人的了解，似乎在末日前就已潜入国内。",
      "personality": "冷酷、理性、目的性极强。将任务置于一切之上，视人命如草芥，但并非单纯的杀戮狂，其行动皆有明确的战略目的。",
      "current_goal": "潜入并破坏秦始皇布下的防御体系，收集丧尸病毒与血脉传承的关键数据，为境外势力的全面入侵铺平道路。",
      "first_chapter": 91,
      "current_status": "存活"
    }
  ],
  "foreshadowing": [
    {
      "id": "F1",
      "content": "林轩祖父遗留的玉佩在丧尸靠近时微微发热，暗示其与秦始皇血脉的隐秘关联。",
      "plant_node": "B1",
      "payoff_node": "T3"
    },
