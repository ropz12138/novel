  "characters": [
    {
      "age": "21",
      "name": "林轩",
      "gender": "男",
      "skills": "主异能“帝威”：可释放精神威压，压制低阶丧尸，影响他人意志（初期微弱，后期强大）。丧尸能力：尸毒免疫（被咬后未完全尸化）、丧尸感知（能模糊感知周围丧尸位置和情绪）、尸化强化（主动或被动进入状态，身体素质大幅提升，但需控制理智，否则有失控风险）。两种能力结合，形成以精神压制开路、近身爆发输出的独特战斗风格。",
      "role_type": "主角",
      "appearance": "身高178cm，体型偏瘦但结实，短发，眉眼间有一股不易察觉的锐气。感染后，瞳孔偶尔会闪过一丝不易察觉的暗金色，皮肤在尸化强化时会浮现淡淡的黑色纹路，但很快消失。",
      "background": "普通家庭出身的在校大学生，父母早亡，由祖父抚养长大。祖父临终前留下一块刻有古怪纹路的玉佩，叮嘱他“关键时刻能救命”。他并不知道自己是秦始皇后裔。",
      "personality": "性格沉稳，有责任感，平时略显内向，但在危机时刻能爆发出惊人的决断力和领导力。对朋友忠诚，对陌生人保持警惕。内心深处有对力量的渴望，但被理智和道德束缚。",
      "current_goal": "在末日初期保护室友和同学，寻找安全的生存环境，并查明自己被咬后未尸化的原因。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "23",
      "name": "苏晴",
      "gender": "女",
      "skills": "优秀的体能和格斗技巧（大学是武术社成员），冷静的分析能力，出色的野外生存知识（受父母影响）。在林轩觉醒过程中，她的陪伴和呼唤是关键精神支柱。",
      "role_type": "主角",
      "appearance": "身高168cm，身材匀称，长发常扎成干练的马尾。面容清冷，眼神锐利，但偶尔流露出对林轩的关切。穿着实用，行动敏捷。",
      "background": "与林轩是青梅竹马，比他大两岁，在不同大学就读。家境较好，父母是科研人员，从小接受良好教育，独立性强。末日爆发时，她第一时间想到的就是林轩。",
      "personality": "外冷内热，表面严肃理性，实则内心柔软，尤其对林轩极为在意。年上者的成熟和保护欲强烈，做事果断，不拖泥带水。在危机中是可靠的后盾和决策者。",
      "current_goal": "在末日爆发后，不惜一切代价找到林轩，并确保他的安全。",
      "first_chapter": 16,
      "current_status": "存活"
    },
    {
      "age": "21",
      "name": "张伟",
      "gender": "男",
      "skills": "强大的近战能力和耐力，擅长使用棍棒等简易武器。体能和力量是团队初期的主要战力。后期可能觉醒与力量相关的异能（待定）。",
      "role_type": "配角",
      "appearance": "身高185cm，体型壮硕，肌肉发达，皮肤黝黑。平头，笑容阳光，但眼神中透着一股不服输的韧劲。常穿运动服。",
      "background": "体育特长生，家境普通，父母是工人。从小热爱运动，身体素质极佳。与林轩、李默是室友，关系铁。末日爆发时，他第一个冲出去查看情况。",
      "personality": "乐观开朗，讲义气，是团队的开心果和士气提振者。性格直爽，有时略显莽撞，但关键时刻靠得住。对朋友绝对忠诚，有强烈的保护欲。",
      "current_goal": "保护好室友和同学，在末日中活下去，并找到家人。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "21",
      "name": "李默",
      "gender": "男",
      "skills": "精通计算机、电子设备维修和黑客技术。后期在破解始皇符文方面展现出惊人的天赋，成为解开世界观真相的关键人物。",
      "role_type": "配角",
      "appearance": "身高175cm，体型偏瘦，戴着一副黑框眼镜。面容清秀，眼神专注，常低头看手机或电脑。穿着随意，不修边幅。",
      "background": "计算机系学霸，家境尚可，父母是教师。从小对电子设备和编程有浓厚兴趣。与林轩、张伟是室友，虽然话不多，但关系融洽。末日爆发时，他正在宿舍调试程序。",
      "personality": "沉默寡言，不善社交，但思维敏捷，逻辑性强。对技术问题有近乎偏执的钻研精神。内心善良，但表达方式直接，有时显得冷漠。是团队的智囊和技术核心。",
      "current_goal": "利用技术能力帮助团队生存，并破解末日爆发背后的秘密。",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "22",
      "name": "王琳",
      "gender": "女",
      "skills": "卓越的组织管理能力、危机处理能力、基础急救知识、出色的口才与说服力。末日初期没有觉醒异能，依靠智慧和领导力生存。",
      "role_type": "配角",
      "appearance": "身材高挑，约170cm，短发干练，常戴一副细框眼镜。面容清秀但眼神锐利，习惯性挺直脊背，穿着整洁得体，即使在末日初期也尽量保持仪容。",
      "background": "出身普通家庭，父母是工薪阶层，从小成绩优异，凭借个人努力成为学生会主席。末日前正准备考研，对未来有清晰规划。末日爆发后，她迅速组织起一部分学生，在图书馆建立了初步据点，成为校园内一股重要势力。",
      "personality": "外冷内热，极度理性，有强烈的控制欲和责任感。末日前是典型的学生领袖，善于组织协调，但内心深处害怕失控。末日初期因恐惧而变得强势甚至独断，后期逐渐展现出真正的领导力与人性光辉。",
      "current_goal": "在末日中维持秩序，保护尽可能多的学生，并试图寻找外界救援。对男主林轩的能力既警惕又渴望合作，以巩固自己的领导地位。",
      "first_chapter": 26,
      "current_status": "存活"
    },
    {
      "age": "20",
      "name": "陈雪",
      "gender": "女",
      "skills": "扎实的医学理论知识、基础外科手术能力、病毒学基础知识、冷静的判断力。末日初期没有觉醒异能，是纯粹的技术型人才。",
      "role_type": "配角",
      "appearance": "娇小玲珑，约160cm，长发常扎成马尾，圆脸，戴一副圆框眼镜，眼神温和而专注。穿着朴素，常背着一个装满医疗用品的双肩包。",
      "background": "医学系大三学生，父亲是医生，母亲是护士，从小耳濡目染。末日前正在准备执业医师考试，对病毒学和传染病学有浓厚兴趣。末日爆发后，她利用专业知识救治伤员，成为团队不可或缺的医疗支援。",
      "personality": "温柔善良，有些内向，但专业领域极其认真严谨。富有同情心，见不得他人受苦，有时会因过度共情而陷入情绪低谷。对未知事物充满好奇，尤其是对丧尸病毒的本质。",
      "current_goal": "救治伤员，研究丧尸病毒的特性和传播途径，希望能找到克制病毒的方法。对男主林轩的免疫能力非常好奇，认为这是研究病毒的关键突破口。",
      "first_chapter": 26,
      "current_status": "存活"
    },
    {
      "age": "45",
      "name": "赵铁柱",
      "gender": "男",
      "skills": "精湛的军事素养、格斗射击技能、出色的战术指挥能力、强大的领导魅力（对追随者）。末日初期没有觉醒异能，但拥有强大的武装力量。",
      "role_type": "反派",
      "appearance": "身材魁梧，约185cm，肌肉结实，面容刚毅，左脸有一道旧伤疤。常穿军用作战服，腰间配枪，眼神冷酷而坚定，不怒自威。",
      "background": "农村出身，凭借狠劲和战功一步步爬到中层军官位置。末日前因一次任务失败被边缘化，心怀不满。末日爆发后，他迅速集结了一批忠诚的士兵，建立了自己的军事化势力，以“铁腕秩序”为名，实则进行残酷统治。",
      "personality": "极端现实主义者，信奉力量至上，为达目的不择手段。末日前是某部队的中层军官，有丰富的实战经验。末日后认为旧秩序已崩坏，只有铁腕和绝对力量才能重建秩序，对平民的生死漠不关心。",
      "current_goal": "建立以自己为核心的绝对统治秩序，不惜一切代价获取力量（包括捕获丧尸或异能者进行研究）。视男主林轩的异能为潜在威胁或可利用的工具。",
      "first_chapter": 46,
      "current_status": "存活"
    },
    {
      "age": "30",
      "name": "嬴玄",
      "gender": "男",
      "skills": "强大的“帝威”异能（可能比男主更精纯）、对古老符文和阵法的精通、深不可测的谋略、悠久岁月积累的知识与经验。",
      "role_type": "配角",
      "appearance": "身材修长，约180cm，黑发束于脑后，面容俊美但苍白，眼神深邃如古井，常穿改良的汉服或中山装。气质古典而疏离，仿佛不属于这个时代。",
      "background": "自称秦始皇后裔，血脉觉醒者。真实身份成谜，似乎活了很久，对历史和始皇的布局有超乎常人的了解。末日前隐居于世，末日爆发后现身，寻找其他血脉觉醒者，尤其是男主林轩。",
      "personality": "神秘莫测，极度理性，将一切视为棋局。对秦始皇的布局了如指掌，认为自己是计划的执行者而非参与者。对人类情感嗤之以鼻，但偶尔会流露出对“同类”（血脉觉醒者）的复杂情绪。",
      "current_goal": "引导（或操控）男主林轩完成秦始皇布局的最终阶段，抵御“境外天魔”的入侵。对男主的态度是亦师亦友，但最终目的成谜。",
      "first_chapter": 91,
      "current_status": "存活"
    },
    {
      "age": "不详",
      "name": "尸王",
      "gender": "男",
      "skills": "【尸群指挥】：可控制方圆数公里内的普通丧尸，形成尸潮进行攻击或防御。\n【骨刺风暴】：从脊背射出坚硬骨刺，可穿透混凝土墙体。\n【生命汲取】：通过吞噬血肉快速恢复伤势与提升实力。\n【尸化领域】：在其周围百米内，普通人类会感到生命力被缓慢抽离，丧尸则会变得更加强大。\n【天魔化】：最终阶段，吸收足够生命能量后，胸口晶核破碎，与天魔意志融合，实力暴涨，可撕裂空间。",
      "role_type": "反派",
      "appearance": "身高超过三米的类人形怪物，皮肤呈现暗青色，布满龟裂纹路，如同干涸的河床。双目猩红，瞳孔为竖状，散发着幽幽冷光。脊背处延伸出数根骨刺，指尖锋利如刀。最引人注目的是其胸口处镶嵌着一块暗金色的菱形晶核，隐约可见内部有黑色的雾气流转，那是它力量的核心与进化的源头。",
      "background": "并非普通丧尸变异而来，而是秦始皇千年前布下的“尸解仙”计划的失败产物之一。在始皇陵深处沉睡了千年，因末日病毒爆发而苏醒。它本是始皇麾下一名试图通过“尸解”突破帝境的将领，失败后化为不生不灭的怪物，被始皇封印。病毒爆发打破了封印，它吸收了无数丧尸的生命能量，开始疯狂进化，目标是吞噬所有生命，完成当年未竟的“尸解”之路。",
      "personality": "初期只有原始的杀戮本能与对血肉的渴望。随着进化，逐渐展现出狡猾与残忍的智慧，能够指挥尸群进行简单的战术配合。对拥有“帝威”的林轩抱有本能的畏惧与刻骨的仇恨，视其为进化的最大阻碍。最终进化为“天魔先锋”后，被天魔意志侵蚀，成为毁灭的代名词，丧失了大部分个体意识。",
      "current_goal": "吞噬林轩，夺取其体内的“帝威”血脉与始皇遗产，完成终极进化，成为新时代的“尸解仙”。",
      "first_chapter": 76,
      "current_status": "存活（进化中）"
    }
  ],
