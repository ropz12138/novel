      "plant_node": "T3",
      "payoff_node": "T7"
    },
    {
      "id": "F4",
      "content": "抄袭林默产品的巨头公司，其技术路线与未来某家失败企业惊人相似",
      "plant_node": "T4",
      "payoff_node": "T5"
    },
    {
      "id": "F5",
