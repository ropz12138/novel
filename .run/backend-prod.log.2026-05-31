完整大纲：
{
  "story": {
    "genre": "都市科技重生",
    "title": "重启2010：带着AI系统改变世界",
    "volume": "第一卷：重返移动互联网元年"
  },
  "branches": [
    {
      "id": "B1",
      "name": "情感与生活平衡线",
      "side": "left",
      "summary": "林默与陈悦从同事到逐渐相知相恋的感情发展。林默在前世因工作失去所有私人生活，重生后努力学习如何经营感情、享受生活。陈悦帮助林默理解产品思维和用户需求，林默则用技术视角启发陈悦。两人在理念碰撞中互相成长，共同探索工作与生活的平衡之道。",
      "attach_to": "T2",
      "chapter_end": 24,
      "chapter_start": 6
    },
    {
      "id": "B2",
      "name": "创业团队成长线",
      "side": "right",
      "summary": "林默与王强组建创业团队的过程。从最初的三人小团队到逐渐壮大的公司，经历招人困难、技术瓶颈、资金紧张等挑战。团队成员各有性格和理念冲突，林默学习管理艺术，建立不加班的公司文化。王强从冲动冒进逐渐成长为成熟的商务负责人。团队在磨合中建立信任和默契。",
      "attach_to": "T3",
      "chapter_end": 27,
      "chapter_start": 9
    },
    {
      "id": "B3",
      "name": "行业生态与媒体观察线",
      "side": "left",
      "summary": "科技记者赵雅对林默公司的持续关注和深度报道。从最初的怀疑到逐渐认可，赵雅见证了林默团队的创新理念如何影响行业。她通过报道揭露行业乱象，呼吁科技伦理。周明作为投资人的加入，为团队带来资本视角和行业资源，也带来了资本与理想的冲突。这条线展现了移动互联网行业的生态全景。",
      "attach_to": "T5",
      "chapter_end": 27,
      "chapter_start": 17
    },
    {
      "id": "B4",
      "name": "系统秘密与历史蝴蝶效应线",
      "side": "right",
      "summary": "林默逐渐发现ChatGPT系统不仅仅是工具，似乎有自己的意识和目的。他的存在正在改变历史进程：某些本该在2015年才出现的技术提前问世，某些公司命运被改写。系统偶尔发出神秘提示，暗示穿越背后有更大的秘密。林默必须在利用系统优势和保持历史平衡之间找到分寸，同时思考科技发展的真正意义。",
      "attach_to": "T5",
      "chapter_end": 30,
      "chapter_start": 17
    }
  ],
  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "程序员林默连续加班猝死，带着ChatGPT系统穿越到2010年大学毕业前夕。系统觉醒，他决定改变人生轨迹，不再重蹈覆辙。",
      "time_node": "2026年末→2010年春",
      "chapter_end": 4,
      "chapter_start": 1,
      "development_node": "猝死重生与系统觉醒"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "林默拒绝996大厂offer，选择一家小型创业公司。利用AI助手快速完成开发任务，同时用未来知识预判移动互联网趋势，引起同事和上司关注。",
      "time_node": "2010年夏",
      "chapter_end": 8,
      "chapter_start": 5,
      "development_node": "初入职场与技术积累"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "林默开发出一款精准预测用户需求的工具App，获得第一笔投资。他开始组建团队，但面临是否要像前世那样拼命工作的内心挣扎。",
      "time_node": "2010年秋",
      "chapter_end": 12,
      "chapter_start": 9,
      "development_node": "第一桶金与创业萌芽"
    },
    {
      "id": "T4",
      "order": 4,
      "summary": "林默的产品引起巨头关注，遭遇抄袭和打压。团队内部出现分歧：是追求快速发展还是坚持创新理念？林默必须做出选择。",
      "time_node": "2011年初",
      "chapter_end": 16,
      "chapter_start": 13,
      "development_node": "行业竞争与理念冲突"
    },
    {
      "id": "T5",
      "order": 5,
      "summary": "林默利用AI系统开发出领先时代的算法，获得行业认可。但他发现自己的存在正在改变历史进程，某些未来技术提前出现。",
      "time_node": "2011年夏",
      "chapter_end": 20,
      "chapter_start": 17,
      "development_node": "技术突破与行业影响"
    },
    {
      "id": "T6",
      "order": 6,
      "summary": "过度工作导致林默健康出现问题，系统发出警告。他意识到即使有未来知识，也不能忽视生活平衡。开始调整公司文化和管理方式。",
      "time_node": "2011年秋",
      "chapter_end": 24,
      "chapter_start": 21,
      "development_node": "危机与反思"
    },
    {
      "id": "T7",
      "order": 7,
      "summary": "林默的技术推动了移动互联网发展，但他也看到了技术滥用的风险。他开始思考科技伦理，决定建立行业自律规范。",
      "time_node": "2012年初",
      "chapter_end": 27,
      "chapter_start": 25,
      "development_node": "行业变革与责任担当"
    },
    {
      "id": "T8",
      "order": 8,
      "summary": "林默的公司成为行业标杆，但他选择放权给团队，专注于技术研发和人才培养。他找到了工作与生活的平衡，实现了人生价值。",
      "time_node": "2012年春",
      "chapter_end": 30,
      "chapter_start": 28,
      "development_node": "新起点与人生价值"
    }
  ],
  "characters": [
    {
      "age": "25",
      "name": "林默",
      "gender": "男",
      "skills": "精通多种编程语言，熟悉未来16年的技术发展趋势。拥有ChatGPT系统，可随时调用AI助手获取信息、辅助编程、分析问题。具备系统性思维和项目管理能力。",
      "role_type": "主角",
      "appearance": "身高178cm，体型偏瘦，因长期熬夜有明显的黑眼圈和疲惫感。穿越后逐渐恢复健康，眼神从迷茫变得坚定。常穿简单的T恤牛仔裤，不修边幅但干净整洁。",
      "background": "2026年某互联网大厂高级程序员，连续加班三个月后猝死。父母是普通工薪阶层，家庭和睦。大学期间成绩优异，但社交较少。带着对未来16年科技发展的记忆和ChatGPT系统穿越到2010年大学毕业前夕。",
      "personality": "前世：内向、勤奋、责任心强，但缺乏生活情趣，是典型的技术宅。穿越后：表面随和，内心有强烈的改变命运的渴望。善于观察和思考，做事有计划性。逐渐学会拒绝，重视生活品质。",
      "current_goal": "避免重蹈覆辙，不再为工作牺牲健康和生活。利用未来知识在移动互联网领域取得成功，同时找到工作与生活的平衡点。",
      "first_chapter": 1,
      "current_status": "穿越到2010年春，大学毕业前夕。身体从猝死前的亚健康状态逐渐恢复。"
    },
    {
      "age": "24",
      "name": "陈悦",
      "gender": "女",
      "skills": "优秀的产品设计能力，熟悉用户体验设计原则。善于沟通协调，能将技术语言转化为产品需求。对市场趋势有敏锐的嗅觉。",
      "role_type": "女主",
      "appearance": "身高165cm，身材匀称，长发常扎成马尾。面容清秀，笑起来有酒窝。穿着干练得体，偏爱衬衫搭配牛仔裤或半裙。",
      "background": "计算机专业毕业，但选择产品经理方向。在一家小型创业公司工作，对移动互联网产品有浓厚兴趣。家境普通，希望通过自己的努力获得职业发展。",
      "personality": "理性、务实、有主见。对产品有敏锐的洞察力，善于从用户角度思考问题。性格开朗但不张扬，做事有条理。重视团队合作，但也有自己的坚持。",
      "current_goal": "做出一款真正解决用户痛点的产品，在移动互联网领域证明自己的价值。",
      "first_chapter": 5,
      "current_status": "2010年夏，在一家小型创业公司担任产品经理，负责移动端产品设计。"
    },
    {
      "age": "28",
      "name": "张伟",
      "gender": "男",
      "skills": "扎实的技术功底，丰富的项目管理经验。善于团队建设和技术架构设计。对代码质量有极高要求。",
      "role_type": "配角",
      "appearance": "身高180cm，体型健壮，戴一副黑框眼镜。穿着正式，常穿衬衫西裤。表情严肃，不苟言笑，但眼神中透露出对技术的热情。",
      "background": "技术出身，在互联网行业有多年经验。从大公司跳槽到创业公司担任技术总监，希望做出一番事业。对行业发展趋势有自己的见解。",
      "personality": "严谨、务实、追求技术完美。对下属要求严格，但也会给予指导。欣赏有才华的年轻人，但更看重踏实肯干的态度。有领导者的威严，但内心也有柔软的一面。",
      "current_goal": "带领技术团队做出有竞争力的产品，同时培养优秀的技术人才。",
      "first_chapter": 5,
      "current_status": "2010年夏，在一家小型创业公司担任技术总监，负责技术研发团队管理。"
    },
    {
      "age": "26",
      "name": "王强",
