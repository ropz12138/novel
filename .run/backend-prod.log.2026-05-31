  "characters": [
    {
      "age": "21",
      "name": "林辰",
      "gender": "男",
      "skills": "末日前：基础的机械知识，动手能力强，逻辑思维缜密。异能觉醒后：可操控半径10米内的金属物体，初期精度和力量有限；获得丧尸的夜视能力，在黑暗中视物清晰；拥有轻微的自愈能力，小伤口可在数小时内愈合。",
      "role_type": "主角",
      "appearance": "身高178cm，体型偏瘦但结实。留着利落的短发，眉骨较高，眼神在平时显得温和内敛，但在危机时刻会透出一种与年龄不符的锐利与威严。面容清秀，因长期熬夜略显苍白，被咬伤后，伤口周围偶尔会浮现出极淡的金色纹路。",
      "background": "普通在校大学生，主修机械工程。父母早亡，由祖父抚养长大，祖父临终前曾留下一块刻有奇异纹路的古玉，并叮嘱他“关键时刻能救命”。他一直以为这只是老人家的迷信。与青梅竹马苏晴从小一起长大，两人虽不同校，但感情深厚，是彼此最信任的人。",
      "personality": "性格沉稳，责任感强，平时话不多，但内心细腻。对朋友极其忠诚，有保护欲。在末日前是个典型的理工科学生，逻辑性强，但情感表达较为含蓄。面对突如其来的灾难，他展现出超乎寻常的冷静和适应力，骨子里有着一股不服输的韧劲。",
      "current_goal": "在末日中保护苏晴和身边的人，努力掌控新获得的能力，寻找病毒爆发的真相。",
      "first_chapter": 1,
      "current_status": "存活，处于异能觉醒初期，身体正在适应病毒与血脉的融合。"
    },
