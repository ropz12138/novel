  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "丧尸病毒突然爆发，大学校园沦为地狱。男主林辰在混乱中目睹同学变异，艰难求生。青梅竹马苏晴（不同校）通过电话确认彼此安全，约定汇合。",
      "time_node": "末日第1-3天",
      "chapter_end": 15,
      "chapter_start": 1,
      "development_node": "末日爆发与校园沦陷"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "林辰在逃亡中被丧尸咬伤，本应变异却陷入昏迷。苏晴冒险赶来找到他，发现他体温异常但未尸变。林辰体内秦始皇血脉首次被激活，抵抗病毒侵蚀。",
      "time_node": "末日第4-7天",
      "chapter_end": 25,
      "chapter_start": 16,
      "development_node": "首次感染与异常反应"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "林辰苏醒后觉醒了操控金属的异能，同时获得了丧尸的夜视能力和轻微自愈。苏晴陪伴他训练控制新能力，两人关系在生死考验中更加紧密。",
      "time_node": "末日第8-15天",
      "chapter_end": 40,
      "chapter_start": 26,
      "development_node": "异能觉醒与丧尸能力"
    },
    {
      "id": "T4",
      "order": 4,
      "summary": "两人与幸存者在图书馆建立临时据点。林辰逐渐成为团队核心，苏晴负责医疗和后勤。他们遇到其他异能者，开始意识到末日背后另有隐情。",
      "time_node": "末日第16-30天",
