完整大纲：
{
  "story": {
    "genre": "丧尸末日",
    "title": "始皇血脉：末日觉醒",
    "volume": "第一卷：末日降临"
  },
  "branches": [
    {
      "id": "B1",
      "name": "苏晚家族古籍线",
      "side": "right",
      "summary": "苏晚在整理家族古籍时，发现关于“始皇帝境”的详细记载，包括秦始皇修炼突破失败的征兆和丧尸病毒的起源传说。这条线索与林轩在古城遗迹中的发现相互印证，为后续真相揭露埋下伏笔。",
      "attach_to": "T5",
      "chapter_end": 32,
      "chapter_start": 26
    },
    {
      "id": "B2",
      "name": "林轩丧尸控制能力深化",
      "side": "left",
      "summary": "林轩在血脉记忆的指引下，开始系统训练对丧尸的控制能力。他发现可以短暂控制中级丧尸，但每次使用后都会陷入虚弱状态。苏晚利用医学知识帮助他分析能力极限，两人在训练中建立起更深的信任与默契。",
      "attach_to": "T6",
      "chapter_end": 40,
      "chapter_start": 33
    },
    {
      "id": "B3",
      "name": "钢铁堡垒势力接触",
      "side": "right",
      "summary": "林轩团队在搜集物资时与“钢铁堡垒”势力发生首次接触。周铁对林轩的特殊能力产生兴趣，双方在试探与警惕中建立初步联系。这条支线为后续人类内部势力整合埋下伏笔。",
      "attach_to": "T8",
      "chapter_end": 60,
      "chapter_start": 51
    },
    {
      "id": "B4",
      "name": "赵雅丧尸病毒研究",
      "side": "left",
      "summary": "赵雅在秦始皇陵遗迹中发现古代病毒样本，结合现代医学知识开始研究丧尸病毒的本质。她发现病毒具有选择性感染特性，可能与秦始皇的血脉传承有关，为理解异能觉醒机制提供科学依据。",
      "attach_to": "T9",
      "chapter_end": 70,
      "chapter_start": 61
    },
    {
      "id": "B5",
      "name": "魔化丧尸出现与异界裂缝",
      "side": "right",
      "summary": "随着异界魔族的渗透，普通丧尸开始出现魔化变异，攻击力大幅提升且具有群体智慧。林轩首次目睹空间裂缝的形成，感受到异界魔族的恐怖气息。这条支线揭示了丧尸屏障正在被侵蚀的危机。",
      "attach_to": "T10",
      "chapter_end": 80,
      "chapter_start": 71
    },
    {
      "id": "B6",
      "name": "人类觉醒者联盟组建",
      "side": "left",
      "summary": "在林轩和周铁的共同努力下，散落各处的觉醒者势力开始联合。苏晚的冰系异能在团队中发挥关键作用，她与林轩的配合日益默契。这条支线展现了人类在末日中团结抗敌的希望。",
      "attach_to": "T11",
      "chapter_end": 90,
      "chapter_start": 81
    }
  ],
  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "丧尸病毒突然爆发，校园陷入混乱。男主林轩在保护同学时被丧尸咬伤感染，青梅竹马苏晚不顾危险赶到他身边。两人在废弃教学楼中艰难求生，林轩开始出现感染症状。",
      "time_node": "末日第1-3天",
      "chapter_end": 5,
      "chapter_start": 1,
      "development_node": "末日爆发与初始求生"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "林轩在苏晚陪伴下度过感染危机，意外觉醒操控金属的异能，同时获得丧尸的敏锐感知。他发现自己能短暂控制低级丧尸，但能力极不稳定。两人开始寻找安全的避难所。",
      "time_node": "末日第4-10天",
      "chapter_end": 12,
      "chapter_start": 6,
      "development_node": "异能觉醒与能力初现"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "林轩和苏晚在避难所遇到其他幸存者，组建初步生存团队。林轩逐渐掌控异能，带领团队清理丧尸、搜集物资。团队内部出现信任危机，林轩的特殊能力引发部分成员猜疑。",
      "time_node": "末日第11-20天",
      "chapter_end": 20,
      "chapter_start": 13,
      "development_node": "初期团队组建"
    },
    {
      "id": "T4",
      "order": 4,
      "summary": "大规模丧尸潮袭击避难所，林轩为保护众人过度使用异能导致暴走。苏晚冒险唤醒他，两人关系在生死考验中深化。团队被迫转移，林轩体内出现神秘的金色能量波动。",
      "time_node": "末日第21-30天",
      "chapter_end": 25,
      "chapter_start": 21,
      "development_node": "第一次重大危机"
    },
    {
      "id": "T5",
      "order": 5,
      "summary": "团队在古城遗迹中发现刻有秦篆的青铜器，林轩接触后血脉共鸣。苏晚通过家族古籍发现关于“始皇帝境”的记载，两人意识到丧尸病毒可能与秦始皇有关。",
      "time_node": "末日第31-45天",
      "chapter_end": 32,
      "chapter_start": 26,
      "development_node": "秦始皇线索初现"
    },
    {
      "id": "T6",
      "order": 6,
      "summary": "林轩在神秘玉琮指引下进入血脉记忆，看到秦始皇修炼突破的片段。他的异能开始融合丧尸能力，可操控金属化为武器，同时获得超强再生。苏晚成为他唯一的情感依靠。",
      "time_node": "末日第46-60天",
      "chapter_end": 40,
      "chapter_start": 33,
      "development_node": "能力深化与血脉探索"
    },
    {
      "id": "T7",
      "order": 7,
      "summary": "在秦始皇陵外围遗迹中，林轩通过血脉共鸣触发全息投影，看到秦始皇突破失败、病毒扩散的真相。得知丧尸病毒是延缓“异界魔族”入侵的屏障，但信息残缺不全。",
      "time_node": "末日第61-75天",
      "chapter_end": 50,
      "chapter_start": 41,
      "development_node": "真相初步揭露"
    },
    {
      "id": "T8",
      "order": 8,
      "summary": "林轩团队吸引其他幸存者势力关注，与“钢铁堡垒”势力发生冲突。林轩为保护同伴首次完全掌控丧尸化能力，震慑对手。团队建立根据地，开始系统训练觉醒者。",
      "time_node": "末日第76-90天",
      "chapter_end": 60,
      "chapter_start": 51,
      "development_node": "团队壮大与势力冲突"
    },
    {
      "id": "T9",
      "order": 9,
      "summary": "进入秦始皇陵核心区，通过九鼎阵法看到完整真相：秦始皇预见末法时代异界入侵，用丧尸病毒创造生物屏障，自己则化为守护灵沉睡。林轩被确认为血脉继承者，需承担守护使命。",
      "time_node": "末日第91-105天",
      "chapter_end": 70,
      "chapter_start": 61,
      "development_node": "真相完全揭露"
    },
    {
      "id": "T10",
      "order": 10,
      "summary": "丧尸开始出现异变，出现被魔气侵蚀的“魔化丧尸”。林轩感应到空间裂缝波动，首次目睹异界魔族先遣队。人类内部势力争斗加剧，林轩必须在内斗与外敌间做出抉择。",
      "time_node": "末日第106-120天",
      "chapter_end": 80,
      "chapter_start": 71,
      "development_node": "异界威胁显现"
    },
    {
      "id": "T11",
      "order": 11,
      "summary": "林轩整合人类觉醒者势力，建立统一防线。苏晚觉醒冰系异能，成为林轩最得力的搭档与情感归宿。两人在秦始皇陵举行仪式，林轩完全继承始皇血脉力量，准备迎接最终决战。",
      "time_node": "末日第121-135天",
      "chapter_end": 90,
      "chapter_start": 81,
      "development_node": "最终准备与情感升华"
    },
    {
      "id": "T12",
      "order": 12,
      "summary": "异界魔族大军入侵，丧尸屏障开始崩溃。林轩率领人类联军与魔族决战，最终以自身为媒介激活秦始皇留下的终极封印。魔族被击退，丧尸病毒失去活性，人类在废墟上开始重建新秩序。",
      "time_node": "末日第136-150天",
      "chapter_end": 100,
      "chapter_start": 91,
      "development_node": "终极决战与新秩序"
    }
  ],
  "characters": [
    {
      "age": "20",
      "name": "林轩",
      "gender": "男",
      "skills": "末日前：历史知识丰富，体能一般，擅长观察细节。末日后觉醒金属操控异能，可操控半径10米内的金属物体；获得丧尸的敏锐感知（听觉、嗅觉增强）；感染后获得超强再生能力（非致命伤可缓慢愈合）；可短暂控制低级丧尸（能力不稳定，使用后会虚弱）。",
      "role_type": "主角",
      "appearance": "身材清瘦但结实，面容干净，眼神清澈带着一丝书卷气。末日前是普通大学生模样，感染后眼底偶尔会闪过一丝不易察觉的金色流光。穿着简单休闲，偏好深色衣物。",
      "background": "普通家庭出身的在校大学生，主修历史专业。从小由祖父抚养长大，祖父临终前曾含糊提及家族有“特殊血脉”，但林轩一直以为是玩笑。与苏晚从小一起长大，不同校但定期见面。",
      "personality": "性格温和，有点书呆子气，但内心有强烈的责任感和保护欲。面对危机时会爆发出超乎寻常的勇气，但平时略显腼腆。对苏晚有着超越青梅竹马的依赖，但从未明说。",
      "current_goal": "保护苏晚，在末日中生存下去；探索自身异能的真相；寻找安全的避难所",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "22",
      "name": "苏晚",
      "gender": "女",
      "skills": "末日前：医学知识扎实，体能良好（曾学过防身术），观察力敏锐，冷静理性。末日后觉醒冰系异能（在第二卷后期），可制造冰霜、冻结物体；战斗直觉极强；擅长医疗急救和生存规划。",
      "role_type": "主角",
      "appearance": "身高168cm，身材匀称，长发常扎成马尾，面容清冷精致，眼神锐利如刀。穿着干练，偏好运动装或便于行动的衣物。末日前是医学院高材生，气质沉稳。",
      "background": "比林轩大两岁的青梅竹马，就读于另一所大学的医学院。家族世代行医，有古籍收藏传统。从小照顾林轩，将他视为需要保护的弟弟，但内心情感更为复杂。家族古籍中有关于“始皇帝境”的零星记载。",
      "personality": "外冷内热，对陌生人冷淡疏离，但对认定的人（尤其是林轩）会付出一切保护。理性、果断、有领导力，但内心深处藏着温柔和脆弱。不善表达情感，习惯用行动代替语言。",
      "current_goal": "确保林轩的安全；在末日中维持理性与秩序；探索家族古籍中关于秦始皇的秘密",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "21",
      "name": "陈昊",
      "gender": "男",
      "skills": "末日前：体能优秀，擅长篮球和短跑，性格坚韧。末日后未觉醒异能，但通过战斗磨练出精湛的冷兵器（棍棒、刀具）格斗技巧；生存本能强；团队中的肉盾和突击手。",
      "role_type": "配角",
      "appearance": "身材高大健壮，国字脸，浓眉大眼，皮肤黝黑。末日前是体育特长生，常穿运动服。末日后身上增添了几道伤疤，眼神更加坚毅。",
      "background": "林轩的大学室友兼好友，体育学院学生。末日爆发时与林轩一起被困校园，共同经历了最初的混乱与求生。家庭普通，父母在末日初期失联，将团队视为新家人。",
      "personality": "性格豪爽直率，重情重义，有点大大咧咧但关键时刻靠得住。对朋友绝对忠诚，讨厌拐弯抹角。战斗风格勇猛，有时会冲动。",
      "current_goal": "保护团队成员，在末日中活下去；成为林轩最可靠的战友",
      "first_chapter": 13,
      "current_status": "存活"
    },
    {
      "age": "19",
      "name": "赵雅",
      "gender": "女",
      "skills": "精通基础医疗急救、伤口处理、药物调配。对生物学和病毒学有浓厚兴趣，后期开始研究丧尸病毒特性与异能者身体变化。拥有微弱的“生命感知”异能，可模糊感知周围生物的生命力强弱。",
      "role_type": "配角",
      "appearance": "身材娇小，留着齐耳短发，戴着一副黑框眼镜。末日后常穿着便于行动的医护服或运动装，随身携带急救包，眼神清澈而专注，偶尔会因过度思考而显得有些呆滞。",
      "background": "医学院大二学生，末日爆发时正在图书馆自习。凭借冷静的头脑和基础的急救知识，在混乱中救下几名同学并找到临时避难所。后加入林轩团队，成为核心治疗者。",
      "personality": "理性、冷静、有极强的求知欲和责任感。作为医学生，她习惯于用逻辑分析问题，对未知事物既好奇又保持警惕。外在表现温和有礼，但内心有坚定的原则，对同伴的安危极度重视。",
      "current_goal": "在末日中尽可能多地救治伤员，研究丧尸病毒的特性，寻找治愈感染的可能性，并确保团队成员的健康安全。",
      "first_chapter": 13,
      "current_status": "存活"
    },
    {
      "age": "未知",
      "name": "秦始皇",
      "gender": "男",
      "skills": "帝境修炼者（已陨落）：曾掌控天地之力，可操控金属、能量、空间；创造丧尸病毒的禁术；血脉传承之法；九鼎封印大阵；意识投影与记忆传承。布下血脉传承阵法，确保每代都会出现血脉继承者，形成'守护者循环'系统。",
      "role_type": "配角",
      "appearance": "通过血脉记忆和遗迹投影出现的形象：身穿玄色龙袍，头戴十二旒冕冠，面容威严深邃，眼神如深渊般不可测。身形高大挺拔，举手投足间有帝王霸气。投影有时会呈现半透明金色。",
      "background": "历史上第一个统一中国的皇帝，实则是末法时代最后的帝境修炼者。预见异界魔族将入侵人间，为延缓入侵，以自身突破失败为代价创造丧尸病毒作为生物屏障。通过秘法将意识与力量封存于血脉和遗迹中，同时布下血脉传承阵法，确保每代都会出现血脉继承者，形成'守护者循环'系统，等待继承者出现激活终极封印。",
      "personality": "千古一帝的威严与深谋远虑并存。冷酷果断，为达目的不择手段，但内心有守护人间的执念。对血脉继承者既严厉又期待，视其为使命传承者。",
      "current_goal": "等待血脉继承者出现，传承使命，激活终极封印，守护人间界",
      "first_chapter": 26,
      "current_status": "沉睡/意识残留"
    },
    {
      "age": "35",
      "name": "周铁",
      "gender": "男",
      "skills": "顶尖的近身格斗与冷兵器使用技巧，精通枪械与陷阱制作。拥有“钢骨”异能，可短时间内让身体局部皮肤和骨骼硬化，大幅提升防御力与力量。具备出色的战术指挥与基地建设能力。",
      "role_type": "配角",
      "appearance": "身材魁梧壮硕，肌肉线条分明，面容刚毅，下巴留着短硬的胡茬。常穿着改装过的工装或简易护甲，手臂上有旧伤疤。眼神锐利如鹰，行动间带着军人般的利落与压迫感。",
      "background": "退伍特种兵，末日爆发时正在城郊的工业区工作。凭借过硬的军事素养和战斗力，迅速收拢幸存者，建立以旧工厂为核心的“钢铁堡垒”势力。初期采取封闭保守策略，对一切外来者保持警惕。",
      "personality": "强势、务实、有强烈的领地意识和保护欲。信奉力量与秩序，对弱者有本能的保护欲，但对威胁到自己地盘和手下的人毫不留情。重承诺，一旦认可对方便会成为可靠的盟友。",
      "current_goal": "保护“钢铁堡垒”内的所有幸存者，建立一个稳固、自给自足的末日据点。在认清异界魔族的威胁后，目标转变为团结人类力量，共同抵御外敌。",
      "first_chapter": 51,
      "current_status": "存活"
    },
    {
      "age": "未知",
      "name": "魔帅·暗渊",
      "gender": "男",
      "skills": "掌控强大的“暗影”与“侵蚀”之力，可操纵黑暗能量进行攻击、防御和精神侵蚀。能将生物转化为听命于己的“魔化丧尸”。拥有空间穿梭（短距离）和能量吞噬的能力。",
      "role_type": "反派",
      "appearance": "人形，但身高接近三米，体表覆盖着暗紫色的、带有金属光泽的甲壳。面容模糊，笼罩在不断流动的阴影中，只能看到两点猩红的光芒作为眼睛。背后有数条由纯粹黑暗能量构成的、可自由伸缩的触须状肢体。",
      "background": "异界魔族中的一位强大统帅，在魔族中亦属顶尖战力。奉命率先遣队寻找并突破“位面屏障”（即丧尸病毒形成的生物屏障），为魔族大军入侵人间界铺平道路。对秦始皇留下的屏障既感到愤怒又有一丝忌惮。",
      "personality": "冷酷、傲慢、视低等生命为草芥。以征服和吞噬为乐，对力量有着极致的追求。战术上狡猾多疑，善于利用恐惧和混乱瓦解敌人意志，但本质上极度自负，轻视人类的反抗意志。",
      "current_goal": "摧毁秦始皇留下的丧尸病毒屏障，打开通往人间界的稳定通道，为魔族大军全面入侵扫清障碍，并夺取人间界的资源与能量。",
      "first_chapter": 71,
      "current_status": "存活（作为异界入侵的先锋）"
    }
  ],
