完整大纲：
{
  "story": {
    "genre": "丧尸末日",
    "title": "秦血觉醒：丧尸末日中的始皇传承",
    "volume": "第一卷：病毒爆发与血脉觉醒"
  },
  "branches": [
    {
      "id": "B1",
      "name": "苏晴的求生之路",
      "side": "left",
      "summary": "从苏晴视角展开，展现她在医学院的末日初体验。她凭借医学知识和体能优势，在混乱中组织同学自救，同时通过无线电和电话艰难联系林辰。这条支线详细描写她穿越沦陷城区、克服重重危险赶往林辰所在校园的过程，展现她外冷内热的性格和对林辰深藏的情感。",
      "attach_to": "T1",
      "chapter_end": 15,
      "chapter_start": 1
    },
    {
      "id": "B2",
      "name": "陈默的校园保卫战",
      "side": "right",
      "summary": "聚焦陈默在体育场馆区域的生存经历。他凭借出色的体能和格斗技巧，保护了一批被困的体育生和教职工。在建立小型避难所的过程中，他遇到了资源掠夺者的威胁，被迫做出艰难抉择。这条支线展现他从体育特长生到末日战士的转变，以及他如何最终带领幸存者与林辰团队汇合。",
      "attach_to": "T4",
      "chapter_end": 55,
      "chapter_start": 41
    },
    {
      "id": "B3",
      "name": "赵雪的植物奇迹",
      "side": "left",
      "summary": "描写赵雪在图书馆地下室发现变异植物的经历。她利用农学知识，尝试培育可食用作物，却意外触发了植物操控异能。这条支线展现她如何克服内向性格，用植物知识为团队建立可持续食物供应，以及她与植物之间神秘联系的逐步加深。",
      "attach_to": "T4",
      "chapter_end": 55,
      "chapter_start": 41
    },
    {
      "id": "B4",
      "name": "周远的势力崛起",
      "side": "right",
      "summary": "从反派视角展现周远如何在末日中建立自己的黑暗王国。他利用人性的恐惧和贪婪，通过心理操控和暴力手段聚集追随者，控制了超市、药店等关键资源点。这条支线揭示他的背景故事、扭曲心理，以及他对林辰团队的觊觎和初步试探。",
      "attach_to": "T4",
      "chapter_end": 55,
      "chapter_start": 41
    },
    {
      "id": "B5",
      "name": "王教授的秦代密码",
      "side": "left",
      "summary": "王教授在末日中坚持研究秦代竹简，发现其中隐藏着关于“天地异变”和“帝王布局”的隐晦记载。他通过古文字破译，逐渐拼凑出秦始皇预见未来危机的线索。这条支线展现学者在末日中的执着，以及他如何将历史知识转化为对抗危机的关键信息。",
      "attach_to": "T5",
      "chapter_end": 70,
      "chapter_start": 56
    },
    {
      "id": "B6",
      "name": "张薇的侦察日记",
      "side": "right",
      "summary": "以张薇的视角记录她觉醒感知异能后的侦察经历。她利用新能力为团队预警危险，同时用望远镜和笔记本记录下末日中的点点滴滴。这条支线展现她从活泼学生到团队‘眼睛’的成长，以及她对周围环境的敏锐观察和情感记录。",
      "attach_to": "T3",
      "chapter_end": 40,
      "chapter_start": 26
    },
    {
      "id": "B7",
      "name": "李队长的军事集结",
      "side": "right",
      "summary": "描写李队长带领特种小队在末日中寻找幸存者和军事资源的过程。他们遭遇了丧尸群、变异生物和其他幸存者势力的挑战。这条支线展现现代军事力量在末日中的适应与转变，以及李队长如何最终决定与林辰团队合作，共同应对更大的威胁。",
      "attach_to": "T6",
      "chapter_end": 85,
      "chapter_start": 71
    },
    {
      "id": "B8",
      "name": "血脉共鸣的代价",
      "side": "left",
      "summary": "深入描写林辰完全觉醒始皇血脉时的身体和精神变化。他承受着血脉力量带来的剧痛和幻象，苏晴用医学知识和情感支持帮助他度过难关。这条支线展现异能觉醒的残酷代价，以及两人在极限压力下情感羁绊的深化。",
      "attach_to": "T7",
      "chapter_end": 95,
      "chapter_start": 86
    }
  ],
  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "丧尸病毒突然爆发，大学校园沦为地狱。男主林辰在混乱中目睹同学变异，艰难求生。青梅竹马苏晴（不同校）通过电话确认彼此安全，约定汇合。",
      "time_node": "末日第1-3天",
      "chapter_end": 15,
      "chapter_start": 1,
      "development_node": "末日爆发与校园沦陷"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "林辰在逃亡中被丧尸咬伤，本应变异却陷入昏迷。苏晴冒险赶来找到他，发现他体温异常但未尸变。林辰体内秦始皇血脉首次被激活，抵抗病毒侵蚀。",
      "time_node": "末日第4-7天",
      "chapter_end": 25,
      "chapter_start": 16,
      "development_node": "首次感染与异常反应"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "林辰苏醒后觉醒了操控金属的异能，同时获得了丧尸的夜视能力和轻微自愈。苏晴陪伴他训练控制新能力，两人关系在生死考验中更加紧密。",
      "time_node": "末日第8-15天",
      "chapter_end": 40,
      "chapter_start": 26,
      "development_node": "异能觉醒与丧尸能力"
    },
    {
      "id": "T4",
      "order": 4,
      "summary": "两人与幸存者在图书馆建立临时据点。林辰逐渐成为团队核心，苏晴负责医疗和后勤。他们遇到其他异能者，开始意识到末日背后另有隐情。",
      "time_node": "末日第16-30天",
      "chapter_end": 55,
      "chapter_start": 41,
      "development_node": "建立据点与团队雏形"
    },
    {
      "id": "T5",
      "order": 5,
      "summary": "林辰接触秦代文物时出现幻象，看到模糊的帝王身影和古老仪式。他开始怀疑自己的家族历史，向苏晴倾诉困惑。两人决定调查病毒起源。",
      "time_node": "末日第31-45天",
      "chapter_end": 70,
      "chapter_start": 56,
      "development_node": "血脉共鸣与神秘幻象"
    },
    {
      "id": "T6",
      "order": 6,
      "summary": "通过古籍和遗迹线索，林辰发现丧尸病毒源于秦始皇的失败突破尝试。始皇帝预见外敌入侵，用另类方式布局延缓危机，病毒爆发是计划的一部分。",
      "time_node": "末日第46-60天",
      "chapter_end": 85,
      "chapter_start": 71,
      "development_node": "中期真相揭露：秦始皇的谋划"
    },
    {
      "id": "T7",
      "order": 7,
      "summary": "林辰完全觉醒始皇血脉，获得更强大的异能。他理解了自己作为传承者的使命，与苏晴共同面对即将到来的更大威胁。两人关系升华为超越爱情的羁绊。",
      "time_node": "末日第61-75天",
      "chapter_end": 95,
      "chapter_start": 86,
      "development_node": "血脉觉醒与责任担当"
    },
    {
      "id": "T8",
      "order": 8,
      "summary": "境外变异生物开始出现，验证了秦始皇的预言。林辰带领团队迎战新威胁，苏晴成为他最坚实的后盾。故事在人类反击的号角中暂告段落。",
      "time_node": "末日第76-90天",
      "chapter_end": 100,
      "chapter_start": 96,
      "development_node": "外敌初现与新纪元开端"
    }
  ],
  "characters": [
    {
      "age": "21",
      "name": "林辰",
      "gender": "男",
      "skills": "末日前：基础的机械知识，动手能力强，逻辑思维缜密。异能觉醒后：可操控半径10米内的金属物体，初期精度和力量有限；获得丧尸的夜视能力，在黑暗中视物清晰；拥有轻微的自愈能力，小伤口可在数小时内愈合。",
      "role_type": "主角",
      "appearance": "身高178cm，体型偏瘦但结实。留着利落的短发，眉骨较高，眼神在平时显得温和内敛，但在危机时刻会透出一种与年龄不符的锐利与威严。面容清秀，因长期熬夜略显苍白，被咬伤后，伤口周围偶尔会浮现出极淡的金色纹路。",
      "background": "普通在校大学生，主修机械工程。父母早亡，由祖父抚养长大，祖父临终前曾留下一块刻有奇异纹路的古玉，并叮嘱他“关键时刻能救命”。他一直以为这只是老人家的迷信。与青梅竹马苏晴从小一起长大，两人虽不同校，但感情深厚，是彼此最信任的人。",
      "personality": "性格沉稳，责任感强，平时话不多，但内心细腻。对朋友极其忠诚，有保护欲。在末日前是个典型的理工科学生，逻辑性强，但情感表达较为含蓄。面对突如其来的灾难，他展现出超乎寻常的冷静和适应力，骨子里有着一股不服输的韧劲。",
      "current_goal": "在末日中保护苏晴和身边的人，努力掌控新获得的能力，寻找病毒爆发的真相。",
      "first_chapter": 1,
      "current_status": "存活，处于异能觉醒初期，身体正在适应病毒与血脉的融合。"
    },
    {
      "age": "23",
      "name": "苏晴",
      "gender": "女",
      "skills": "末日前：扎实的医学知识，包括急救、外科处理和药物知识；体能良好，曾是校田径队成员。异能觉醒后（后期）：暂未觉醒，但凭借出色的观察力和学习能力，能快速适应末日环境，成为团队不可或缺的医疗和后勤保障。",
      "role_type": "主角",
      "appearance": "身高168cm，身材匀称。长发常束成高马尾，显得干练。五官精致，眉眼间自带一股清冷疏离感，但笑起来时嘴角会有浅浅的梨涡。习惯穿着简洁实用的衣物，末日后更是一身便于行动的户外装束。",
      "background": "比林辰大两岁的青梅竹马，就读于另一所大学的医学院，主修临床医学。父母是普通工薪阶层，家庭和睦。从小成绩优异，性格独立。与林辰一同长大，是少数能看透他沉默外表下柔软内心的人。末日爆发时，她第一时间想到的就是确认林辰的安全。",
      "personality": "外冷内热，表面对人疏离淡漠，实则内心柔软，重情重义。做事果断，有主见，执行力极强。对林辰有着超越青梅竹马的复杂情感，既有姐姐般的关怀，也有未曾言明的守护欲。在危机面前异常冷静，是团队中可靠的决策者和后勤核心。",
      "current_goal": "确保林辰的安全与稳定，协助他掌控能力，在末日中建立一个相对安全的生存环境。",
      "first_chapter": 1,
      "current_status": "存活，身体健康，正全力照顾和协助林辰适应异能。"
    },
    {
      "age": "19",
      "name": "张薇",
      "gender": "女",
      "skills": "觉醒感知异能，能探测半径约50米内丧尸的位置和大致数量，对危险有本能的预感。擅长观察、记录、基础摄影和快速奔跑。",
      "role_type": "配角",
      "appearance": "扎着高马尾，面容清秀，眼睛很大，眼神灵动。身材纤细，动作敏捷。喜欢穿运动服和跑鞋，方便随时行动。随身带着一个小巧的望远镜。",
      "background": "林辰的大学同学，新闻系学生，梦想成为一名战地记者。末日爆发时，她凭借出色的观察力和对环境的敏感，多次帮助同学躲避危险。",
      "personality": "活泼开朗，有点话痨，是团队里的气氛调节剂。但关键时刻非常可靠，观察力敏锐，心思细腻。对朋友非常忠诚。",
      "current_goal": "利用自己的感知能力，成为团队的‘眼睛’和‘耳朵’，提前预警危险，保障据点安全。",
      "first_chapter": 26,
      "current_status": "存活"
    },
    {
      "age": "22",
      "name": "陈默",
      "gender": "男",
      "skills": "末日前：出色的体能、力量和耐力，掌握基础的格斗技巧和急救知识。异能觉醒后：强化体质，力量、速度、防御力均得到显著提升，抗打击能力远超常人。",
      "role_type": "配角",
      "appearance": "身高185cm，体型魁梧健硕，肌肉线条明显。面容刚毅，颧骨和下颌线分明，眼神沉稳坚定。常穿工装或耐磨的户外服装，身上常有训练或战斗留下的细小伤疤。",
      "background": "大学生，体育特长生，主修体育教育。家庭普通，父母是工人。从小体格出众，性格内向但坚韧。末日前曾是校篮球队主力，也兼职做过健身教练。末日爆发时，他凭借出色的体能和冷静的头脑，在校园中保护了一批同学，并带领他们向相对安全的区域转移。",
      "personality": "沉默寡言，行动派，信奉力量与秩序。责任感强，对认可的同伴极其忠诚，有强烈的保护欲。不善言辞，但用实际行动表达关心。在末日前可能受过纪律部队的训练或影响，行事作风严谨高效。",
      "current_goal": "在末日中保护更多幸存者，追随林辰，寻找建立长久安全家园的可能。",
      "first_chapter": 41,
      "current_status": "存活，异能已初步觉醒并能稳定运用，是团队的核心战斗成员。"
    },
    {
      "age": "20",
      "name": "赵雪",
      "gender": "女",
      "skills": "觉醒植物操控异能，能加速植物生长、感知植物状态、与植物进行微弱沟通。擅长农业种植、野外植物辨识、基础园艺。",
      "role_type": "配角",
      "appearance": "身材娇小，皮肤因长期在室内而略显苍白。留着齐耳短发，方便活动。常穿宽松的旧T恤和工装裤，袖口和裤脚总是挽着。指甲缝里常有泥土，眼神专注而平静。",
      "background": "农学院大二学生，家在农村，从小跟着爷爷奶奶种地，对植物生长有天然的亲和力和丰富知识。末日爆发时正在图书馆查阅资料，被困后凭借冷静和植物知识帮助大家寻找可食用植物。",
      "personality": "性格内向、安静，甚至有些怕生。但在末日环境下，为了生存和团队，她强迫自己变得坚韧。内心善良，对植物有特殊的情感，认为它们是末日中难得的希望。",
      "current_goal": "在图书馆据点建立可持续的食物供应系统，确保团队不会因饥饿而崩溃。",
      "first_chapter": 41,
      "current_status": "存活"
    },
    {
      "age": "28",
      "name": "周远",
      "gender": "男",
      "skills": "精通心理操控和权术，善于利用人性的弱点（如恐惧、贪婪）来控制他人。拥有不错的近身格斗技巧和野外生存知识。擅长资源管理和据点防御策略，但手段往往不人道。",
      "role_type": "反派",
      "appearance": "身材高大但略显瘦削，面容消瘦，眼窝深陷，眼神中透着一种偏执的疯狂和对资源的贪婪。常穿着破旧但干净的外套，腰间别着一把自制的砍刀，手指关节因长期紧握武器而布满老茧。",
      "background": "末日前是一名普通的公司职员，生活压力巨大，对社会充满不满。末日爆发后，他迅速适应了残酷的环境，凭借狠辣的手段聚集了一批追随者，建立了自己的小势力。他内心深处渴望权力和掌控感，末日给了他实现这种欲望的舞台。",
      "personality": "极度自私、冷酷无情，为了生存可以牺牲任何人。他信奉“弱肉强食”的末日法则，认为道德和情感是奢侈品。他善于伪装，初期可能表现出领导力，但本质是控制欲强、多疑且残忍的独裁者。",
      "current_goal": "扩大自己的势力范围，夺取更多生存资源，成为末日中的“王”。他视林辰团队为威胁和潜在的资源掠夺目标，计划通过武力或诡计消灭或吞并他们。",
      "first_chapter": 41,
      "current_status": "存活"
    },
    {
      "age": "不详",
      "name": "秦始皇",
      "gender": "男",
      "skills": "准帝境修为（已失败），拥有对天地气运的感知与操控能力（部分遗留），布局与谋划能力冠绝古今。其失败产物“丧尸病毒”具有感染、变异生物的特性。",
      "role_type": "配角",
      "appearance": "在林辰的幻象中，是一位身着玄色龙袍、头戴十二旒冕冠的帝王身影。面容模糊不清，但能感受到其威严与压迫感。身形高大挺拔，即便只是虚影，也散发着睥睨天下的气势。偶尔在文物共鸣时，会闪过一双深邃如星空的眼眸。",
      "background": "千古一帝，统一六国，建立不世功勋。在末法时代，灵气日益稀薄，其修为被困于准帝境，无法突破。他凭借超凡的感知力，预见到了未来来自“境外”的毁灭性入侵。为了给人类争取一线生机，他尝试以“万民愿力”和“地脉龙气”强行冲击帝境，但最终失败。失败产生的负面能量与天地怨气结合，形成了最初的丧尸病毒。然而，他在失败前已通过某种秘法，将部分力量与布局埋藏于血脉和历史之中，用以延缓外敌入侵的进程，并等待后世血脉觉醒者。",
      "personality": "雄才大略，意志坚定，为达目的不择手段，但心怀天下苍生。拥有超越时代的眼光和魄力，敢于挑战规则。在面临末法时代和外敌威胁时，展现出极端的决绝与深远的布局能力。其意志即便跨越千年，依然在影响着后世。",
      "current_goal": "通过预设的布局和血脉传承者（林辰），继续延缓并最终对抗“境外”入侵，为人类文明争取存续的机会。",
      "first_chapter": 56,
      "current_status": "肉身早已消亡，但意志与部分力量通过血脉和历史布局得以延续，处于某种“沉眠”或“观察”状态。"
    },
    {
      "age": "55",
      "name": "王教授",
      "gender": "男",
      "skills": "拥有渊博的秦汉历史知识，精通古文字（包括部分失传的秦篆变体），具备强大的文献分析和逻辑推理能力。",
      "role_type": "配角",
      "appearance": "头发花白，戴着一副老式金丝边眼镜，镜片后是一双锐利而深邃的眼睛。身材清瘦但精神矍铄，即使在末日也保持着学者的整洁，衬衫纽扣总是扣到最上面一颗。",
      "background": "国内顶尖大学的历史系教授，专攻秦汉史，尤其痴迷于秦始皇时期未解之谜。家中收藏了大量相关古籍和文物。末日爆发时正在整理一批新发现的秦代竹简。",
      "personality": "治学严谨，性格固执但内心正直。对历史真相有近乎偏执的追求，面对末日危机，他将寻找真相视为自己的责任。对年轻人既有长辈的严厉，也有学者的关怀。",
      "current_goal": "利用毕生所学，结合林辰的血脉共鸣现象，揭开秦始皇布局的真相和丧尸病毒的起源。",
      "first_chapter": 56,
      "current_status": "存活"
    },
    {
      "age": "35",
      "name": "李队长",
      "gender": "男",
      "skills": "精通现代军事战术、武器使用、野外生存、近身格斗。拥有强大的战场指挥能力和危机处理能力。",
      "role_type": "配角",
      "appearance": "身高一米八五，体格魁梧，肌肉线条分明。面容刚毅，下巴有一道浅疤。眼神锐利如鹰，扫视周围时带着军人特有的警惕。穿着破损的迷彩作战服，腰间别着军用匕首。",
      "background": "原某特种部队中尉，在一次境外维和任务中负伤回国休养。末日爆发时，他正带领一支小队在附近山区进行适应性训练，是少数保持建制的军事力量之一。",
      "personality": "沉稳、果断、极具责任感。将保护平民和完成任务视为天职。外表严肃，不苟言笑，但内心重情重义，对战友和幸存者有着强烈的保护欲。",
      "current_goal": "寻找并集结更多幸存者和军事力量，建立安全区，并与林辰团队合作，共同对抗丧尸和即将到来的未知威胁。",
      "first_chapter": 71,
      "current_status": "存活"
    },
