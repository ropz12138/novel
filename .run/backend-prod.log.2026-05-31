  "character_briefs": [
    {
      "age": "20",
      "name": "林轩",
      "brief": "拥有秦始皇血脉的在校大学生，被丧尸咬伤后觉醒异能并获得丧尸部分能力，成为末日中的特殊存在",
      "gender": "男",
      "role_type": "主角",
      "first_chapter": 1
    },
    {
      "age": "22",
      "name": "苏晚",
      "brief": "林轩的青梅竹马，外冷内热的年上姐姐，非同校大学生，在末日中陪伴林轩觉醒异能并共同生存",
      "gender": "女",
      "role_type": "主角",
      "first_chapter": 1
    },
    {
      "age": "未知",
      "name": "秦始皇",
      "brief": "古代帝王，突破帝境失败导致丧尸病毒诞生，通过谋划延缓境外入侵，其血脉传承与末日真相密切相关",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 61
    },
    {
      "age": "21",
      "name": "陈默",
      "brief": "林轩的大学室友，在末日爆发后成为生存小队核心成员，擅长战术规划与资源管理",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 10
    },
    {
      "age": "19",
      "name": "赵雪",
      "brief": "幸存者团体领袖，初期与林轩小队冲突，后期成为重要盟友，掌握关键情报资源",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 15
    },
    {
      "age": "55",
      "name": "周教授",
      "brief": "历史学教授，在末日中研究秦始皇遗迹，为林轩揭示血脉与丧尸病毒真相提供关键线索",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 65
    },
    {
      "age": "30",
      "name": "影",
      "brief": "境外势力先遣者，企图利用丧尸病毒与秦始皇谋划的弱点入侵，是最终决战的主要对手",
      "gender": "男",
      "role_type": "反派",
      "first_chapter": 91
    }
  ]
}
