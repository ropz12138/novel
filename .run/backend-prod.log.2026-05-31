  "character_briefs": [
    {
      "age": "21",
      "name": "林辰",
      "brief": "拥有秦始皇血脉的在校大学生，被丧尸咬伤后觉醒操控金属异能并获得丧尸能力，是末日中人类反击的核心传承者",
      "gender": "男",
      "role_type": "主角",
      "first_chapter": 1
    },
    {
      "age": "23",
      "name": "苏晴",
      "brief": "林辰的青梅竹马，外冷内热的年上姐姐，不同校但在末日中冒险赶来陪伴林辰，负责医疗后勤并成为他最坚实的后盾",
      "gender": "女",
      "role_type": "主角",
      "first_chapter": 1
    },
    {
      "age": "不详",
      "name": "秦始皇",
      "brief": "远古帝王，因末法时代灵气稀薄困于准帝境，预见外敌入侵而尝试另类突破失败，丧尸病毒是其失败产物，通过布局延缓危机",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 56
    },
    {
      "age": "22",
      "name": "陈默",
      "brief": "幸存者中的异能觉醒者，拥有强化体质能力，成为林辰团队的核心战力之一",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 41
    },
    {
      "age": "20",
      "name": "赵雪",
      "brief": "图书馆幸存者中的学生，觉醒植物操控异能，负责据点的食物种植和供应",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 41
    },
    {
      "age": "55",
      "name": "王教授",
      "brief": "历史系教授，掌握秦代古籍和文物线索，帮助林辰揭开秦始皇秘密和病毒起源",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 56
    },
    {
      "age": "35",
      "name": "李队长",
      "brief": "军方幸存者小队队长，拥有战术指挥能力，与林辰团队合作对抗丧尸和外敌威胁",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 71
    },
    {
      "age": "19",
      "name": "张薇",
      "brief": "林辰的大学同学，觉醒感知异能，能探测丧尸位置，成为团队的侦察兵",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 26
    },
    {
      "age": "28",
      "name": "周远",
      "brief": "末日中堕落的幸存者头目，为争夺资源与林辰团队对抗，代表人性的黑暗面",
      "gender": "男",
      "role_type": "反派",
      "first_chapter": 41
    },
    {
      "age": "不详",
      "name": "境外变异体",
      "brief": "秦始皇预言的境外入侵者，以变异生物形态出现，是人类面临的新威胁",
      "gender": "无",
      "role_type": "反派",
      "first_chapter": 96
    }
  ]
}
