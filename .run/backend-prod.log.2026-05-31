  "character_briefs": [
    {
      "age": "20",
      "name": "林轩",
      "brief": "拥有秦始皇血脉的在校大学生，末日中觉醒金属操控异能，从普通青年成长为人类守护者",
      "gender": "男",
      "role_type": "主角",
      "first_chapter": 1
    },
    {
      "age": "22",
      "name": "苏晚",
      "brief": "林轩的青梅竹马，外冷内热的年上姐姐，末日中始终陪伴林轩，后觉醒冰系异能成为其灵魂伴侣",
      "gender": "女",
      "role_type": "主角",
      "first_chapter": 1
    },
    {
      "age": "未知",
      "name": "秦始皇",
      "brief": "通过血脉记忆与遗迹投影出现的千古一帝，预见异界入侵而创造丧尸病毒作为生物屏障的谋划者",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 26
    },
    {
      "age": "21",
      "name": "陈昊",
      "brief": "林轩的大学室友，末日初期共同求生的伙伴，后成为团队中的战斗主力与忠诚战友",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 13
    },
    {
      "age": "19",
      "name": "赵雅",
      "brief": "医学生幸存者，团队中的治疗担当，对林轩的特殊能力既好奇又担忧的理性观察者",
      "gender": "女",
      "role_type": "配角",
      "first_chapter": 13
    },
    {
      "age": "35",
      "name": "周铁",
      "brief": "钢铁堡垒势力首领，与林轩团队发生冲突后成为人类联军中的重要盟友",
      "gender": "男",
      "role_type": "配角",
      "first_chapter": 51
    },
    {
      "age": "未知",
      "name": "魔帅·暗渊",
      "brief": "异界魔族先遣队首领，试图突破丧尸屏障入侵人间界的强大敌人",
      "gender": "男",
      "role_type": "反派",
      "first_chapter": 71
    }
  ]
}
