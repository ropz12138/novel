完整大纲：
{
  "story": {
    "genre": "末日丧尸",
    "title": "末日觉醒：秦帝血脉",
    "volume": "四卷完结：末日觉醒与人类存亡（第1-130章）"
  },
  "branches": [
    {
      "id": "B1",
      "name": "苏晴的医疗求索",
      "side": "left",
      "summary": "林默被咬伤感染后，苏晴凭借医学知识和冷静判断，尝试各种方法稳定他的状态。她冒险外出寻找药品和医疗资料，途中遭遇其他幸存者，既获得短暂帮助也面临人性考验。这条支线展现苏晴的独立成长和对林默的深厚羁绊，同时为后续医疗研究线索埋下伏笔。",
      "attach_to": "T2",
      "chapter_end": 20,
      "chapter_start": 11
    },
    {
      "id": "B2",
      "name": "李振的避难所建设",
      "side": "right",
      "summary": "退伍特种兵李振在末日爆发后迅速行动，以大学校园为基础建立幸存者避难所。他组织防御工事、制定生存规则、分配有限资源，同时应对内部矛盾和外部丧尸威胁。这条支线展现末日初期社会组织的形成过程，为林默和苏晴后续加入团队提供背景铺垫。",
      "attach_to": "T3",
      "chapter_end": 30,
      "chapter_start": 25
    },
    {
      "id": "B3",
      "name": "陈浩的潜伏与情报收集",
      "side": "left",
      "summary": "境外势力先遣队成员陈浩以退伍老兵身份潜入幸存者群体，凭借出色的领导能力逐步获得信任。他暗中评估区域内的资源分布、特殊能力者和科学家，同时观察丧尸病毒的实际效果。这条支线为后续境外威胁的揭露埋下伏笔，展现末日下隐藏的更大危机。",
      "attach_to": "T3",
      "chapter_end": 30,
      "chapter_start": 22
    },
    {
      "id": "B4",
      "name": "王教授的病毒研究",
      "side": "right",
      "summary": "生物学教授王教授在失去家人后，将悲痛转化为研究动力。他在简陋的实验室里分析丧尸病毒样本，发现其与某些古代病毒基因的相似性。对林默异变的观察让他产生浓厚兴趣，开始思考病毒起源的可能性。这条支线为第三卷的真相揭示提供科学线索。",
      "attach_to": "T3",
      "chapter_end": 30,
      "chapter_start": 28
    }
  ],
  "timeline": [
    {
      "id": "T1",
      "order": 1,
      "summary": "丧尸病毒突然爆发，城市陷入混乱。男主林默与青梅竹马苏晴（年上）在校园外重逢，共同面对最初的生存危机，建立求生基础。",
      "time_node": "末日第1-7天",
      "chapter_end": 10,
      "chapter_start": 1,
      "development_node": "末日爆发与初始求生"
    },
    {
      "id": "T2",
      "order": 2,
      "summary": "林默为保护苏晴被丧尸咬伤，感染病毒。苏晴不离不弃，陪伴他度过生死关头。林默身体出现异变，但未完全丧尸化，伏笔其血脉特殊性。",
      "time_node": "末日第8-14天",
      "chapter_end": 20,
      "chapter_start": 11,
      "development_node": "咬伤感染与生死关头"
    },
    {
      "id": "T3",
      "order": 3,
      "summary": "林默在昏迷中觉醒初步异能，同时获得类似丧尸的敏锐感知。两人开始寻找安全的避难所，遭遇其他幸存者团队，初步展现末日下的人性百态。",
      "time_node": "末日第15-21天",
      "chapter_end": 30,
      "chapter_start": 21,
      "development_node": "异能初现与避难所寻找"
    }
  ],
  "characters": [
    {
      "age": "20",
      "name": "林默",
      "gender": "男",
      "skills": "被咬伤前：擅长短跑和近身格斗（祖父所授）。被咬伤后：觉醒初步异能，包括超常的感知力（能感知丧尸位置）、身体素质小幅提升、伤口愈合速度加快。同时获得类似丧尸的敏锐听觉和夜视能力。",
      "role_type": "主角",
      "appearance": "身高一米八二，体格偏瘦但结实。皮肤因长期户外训练呈健康的小麦色。眼神深邃，平时略显慵懒，但在危机时刻会变得锐利如鹰。短发，习惯性地将额前碎发拨到一侧。左手腕有一道旧疤，是童年时为保护苏晴留下的。",
      "background": "普通大学生，父母早亡，由祖父抚养长大。祖父在他高中时去世，留下一些古籍和一块祖传玉佩。从小与苏晴一起长大，视她为生命中最重要的人。",
      "personality": "表面沉默寡言，内心坚韧如钢。责任感极强，对认定的人会付出一切。被丧尸咬伤后，性格中多了几分对自身变化的警惕与挣扎，但守护苏晴的信念从未动摇。",
      "current_goal": "保护苏晴活下去",
      "first_chapter": 1,
      "current_status": "存活"
    },
    {
      "age": "22",
      "name": "苏晴",
      "gender": "女",
      "skills": "基础医疗护理、生物化学知识、冷静的危机分析能力、精准的投掷技巧（曾是校垒球队成员）。",
      "role_type": "主角",
      "appearance": "身高一米六八，身材匀称，长发常扎成干练的马尾。面容清冷，眼神锐利，但看向林默时会不自觉地柔和下来。习惯穿便于行动的运动装，随身携带一个急救包。",
      "background": "比林默大两岁的青梅竹马，父母是医生，从小耳濡目染，具备基础的医疗知识。大学主修生物化学，成绩优异。一直默默守护着林默，将照顾他视为自己的责任。",
      "personality": "外冷内热，理性冷静，决策果断。对大多数人保持距离，但对林默有着超越血缘的深厚羁绊。末日降临后，她的冷静与决断成为两人存活的关键。",
      "current_goal": "确保林默的安全并找到安全避难所",
      "first_chapter": 1,
      "current_status": "存活，体力与精神处于高度紧张状态"
    },
    {
      "age": "30",
      "name": "陈浩",
      "gender": "男",
      "skills": "1. 精英级渗透与伪装：能完美扮演不同身份，获取信任。2. 卓越的战术与领导能力：擅长小队指挥、资源分配和危机决策。3. 强大的近身格斗与武器使用能力：精通多种冷兵器和枪械。4. 情报分析与心理操控：善于从细节推断信息，并通过言语引导他人行为。5. 末日生存专家：对资源搜集、营地建设、威胁规避有丰富经验。6. （隐藏）对丧尸病毒有基础了解，知道其部分特性及弱点，这是其所属势力提供的背景情报。",
      "role_type": "反派",
      "appearance": "身材高大健硕，约一米八五，体脂率极低，肌肉线条分明但不夸张，行动时带着一种经过严格训练的流畅感。面容棱角分明，眼神锐利而深邃，习惯性地微眯着，像是在时刻评估周围环境。左眉尾处有一道约两厘米长的淡色旧疤，据他自己说是“以前在工地上被铁丝划的”。为了融入幸存者群体，他刻意穿着破旧但干净的迷彩夹克和工装裤，头发剃得很短，显得干练可靠。",
      "background": "真实身份是境外代号“渡鸦”的入侵势力先遣队精英成员，本名不详。接受过包括情报渗透、野外生存、格斗射击、心理学操控在内的全方位严酷训练。在末日病毒爆发前数月，他已通过合法身份（如国际救援组织顾问）潜入国内，任务是评估该区域人类社会的崩溃程度、幸存者组织形态、资源分布以及潜在抵抗力量。病毒爆发后，他完美利用了混乱，以“有经验的退伍老兵”身份迅速融入一个小型幸存者团体，并凭借出色的领导能力逐步成为核心人物之一，为后续的大规模入侵收集关键情报。",
      "personality": "表面上是冷静、可靠、富有经验的幸存者领袖，善于观察和分析，说话条理清晰，能迅速建立信任。他展现出一种“实用主义”的善良，愿意分享物资，制定规则，给人一种“值得托付”的感觉。然而，其内核是极度的冷漠与功利。他将人类视为需要管理的“资源”或“障碍”，一切行为都以完成“潜伏与评估”的任务为最高优先级。他缺乏共情能力，所有看似友善的举动都是精密计算后的表演。他享受掌控局面的感觉，对“低效”的情感羁绊嗤之鼻鼻。",
      "current_goal": "1. 短期目标：继续巩固在幸存者群体中的地位与影响力，收集该区域所有有价值的情报（包括特殊能力者、科学家、军事设施残余等）。2. 中期目标：找到并接触或清除像王教授这样可能研究出病毒真相的科学家，评估并尝试控制或利用像林默这样的“特殊个体”。3. 长期目标：为“渡鸦”势力的正式登陆与接管铺平道路，尽可能削弱本地人类有组织的抵抗能力，必要时制造内部混乱。",
      "first_chapter": 22,
      "current_status": "存活，已成功潜入并成为某个中型幸存者聚居地的领导层成员之一。"
    },
    {
      "age": "28",
      "name": "李振",
      "gender": "男",
      "skills": "专业的军事战术、武器使用与维护、野外生存技能、领导与组织能力、近身格斗专家。",
      "role_type": "配角",
      "appearance": "身高一米八五，体格健壮，肌肉线条分明。面容刚毅，下巴有一道短疤。眼神沉稳，自带一种令人信服的气场。穿着改装过的战术背心，携带一把自制的工兵铲。",
      "background": "退伍特种兵，因伤退役后在大学担任体育教官。末日爆发时，他凭借军事素养迅速组织起一批幸存者，建立了以校园为基础的避难所。",
      "personality": "沉稳可靠，富有领导力，重视团队纪律与生存效率。对陌生人保持警惕，但认可实力与忠诚。内心深处有保护弱者的信念，但末日让他学会了必要的冷酷。",
      "current_goal": "巩固避难所的防御，寻找更多资源与幸存者，建立可持续的生存秩序。",
      "first_chapter": 25,
      "current_status": "存活，领导着一个约五十人的幸存者团队。"
    },
    {
      "age": "55",
      "name": "王教授",
      "gender": "男",
      "skills": "深厚的生物学与病毒学知识、实验分析能力、对古代文献的解读能力、冷静的逻辑推理。",
      "role_type": "配角",
      "appearance": "身高一米七五，身材清瘦，戴着一副金丝边眼镜。头发花白，面容憔悴但眼神专注。穿着沾有污渍的白大褂，随身携带一个装满笔记和样本的挎包。",
      "background": "国内顶尖的生物学教授，专攻病毒学与遗传学。末日爆发前，曾参与过一个关于古代病毒基因的保密研究项目，隐约察觉到丧尸病毒与某些历史记载的关联。",
      "personality": "学者气质浓厚，理性至上，对科学真相有着近乎偏执的追求。末日让他失去了家人，但将悲痛转化为研究丧尸病毒的动力。对林默的异变表现出极大的研究兴趣。",
      "current_goal": "破解丧尸病毒的起源与传播机制，找到克制或治愈的方法，并解开林默异变背后的秘密。",
      "first_chapter": 28,
      "current_status": "存活，被李振的团队收留，正在避难所的简陋实验室里研究丧尸病毒。"
    }
  ],
