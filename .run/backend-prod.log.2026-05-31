      "appearance": "短发干练，穿着简约大方的职业装，总是背着一个装满资料的帆布包，眼睛明亮有神，采访前会做大量功课",
      "background": "知名科技媒体资深记者，毕业于新闻传播专业，从业五年来报道过多个科技公司的兴衰，对行业有深刻理解，但一直未能找到真正值得深度报道的创新企业",
      "personality": "敏锐聪慧、独立自主、有强烈的职业道德感，对科技行业充满热情，但对资本炒作保持警惕",
      "current_goal": "寻找真正有创新价值的科技公司进行深度报道，希望通过自己的报道推动行业健康发展",
      "first_chapter": 17,
      "current_status": "存活"
    },
    {
      "age": "35",
      "name": "周明",
      "gender": "男",
      "skills": "项目评估、风险投资、商业战略规划、人才培养指导",
      "role_type": "配角",
      "appearance": "中等身材，穿着休闲商务装，戴一副金丝眼镜，说话慢条斯理，喜欢在咖啡厅或茶馆进行商务会谈",
      "background": "资深科技投资人，早年曾是程序员出身，后来转型投资领域，经历过多次科技泡沫，对创业项目有独特的判断标准，特别看重创始人的品格和团队的技术实力",
      "personality": "沉稳理性、眼光独到、注重长期价值而非短期利益，善于发现人才和项目潜力，但投资风格谨慎",
      "current_goal": "寻找有潜力的科技创业项目进行投资，希望通过资本助力真正的技术创新",
      "first_chapter": 21,
      "current_status": "存活"
    }
  ],
  "foreshadowing": [
    {
      "id": "F1",
      "content": "林默猝死时看到的神秘光点，与系统界面偶尔闪烁的异常光芒相似",
      "plant_node": "T1",
      "payoff_node": "T6"
    },
    {
      "id": "F2",
      "content": "林默拒绝的996大厂offer，其创始人后来成为行业重要人物",
      "plant_node": "T2",
      "payoff_node": "T8"
    },
    {
      "id": "F3",
      "content": "林默开发的预测工具算法，后来被发现具有超越时代的特征",
      "plant_node": "T3",
      "payoff_node": "T7"
    },
    {
      "id": "F4",
      "content": "抄袭林默产品的巨头公司，其技术路线与未来某家失败企业惊人相似",
      "plant_node": "T4",
      "payoff_node": "T5"
    },
    {
      "id": "F5",
      "content": "系统偶尔显示的神秘代码片段，与林默前世公司废弃项目代码一致",
      "plant_node": "T5",
      "payoff_node": "T8"
    },
    {
      "id": "F6",
      "content": "林默健康问题出现时，系统提示的医学数据与未来医疗研究成果吻合",
      "plant_node": "T6",
      "payoff_node": "T8"
    }
  ],
