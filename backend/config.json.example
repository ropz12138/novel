{
  "app": {
    "name": "novel-backend",
    "host": "0.0.0.0",
    "dev_port": 9001,
    "prod_port": 9002,
    "debug": true
  },
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "user": "your_db_user",
    "password": "your_db_password",
    "db_name": "novel",
    "echo": false,
    "pool_size": 10,
    "max_overflow": 20,
    "pool_timeout": 30,
    "pool_recycle": 1800
  },
  "llm": [
    {
      "your-model-name": {
        "base_url": "https://your-llm-api-base-url/v1",
        "api_key": "your_llm_api_key"
      }
    },
    {
      "your-pro-model-name": {
        "base_url": "https://your-llm-api-base-url/v1",
        "api_key": "your_llm_api_key"
      }
    }
  ],
  "default_model": "your-model-name",
  "observability": {
    "langsmith_api_key": "your_langsmith_api_key",
    "langsmith_project": "Novel",
    "langsmith_endpoint": "https://api.smith.langchain.com",
    "langsmith_tracing_v2": true
  }
}
